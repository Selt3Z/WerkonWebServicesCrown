# Copy this file to .env and fill in real values.
# .env is ignored by git and must never be committed.
# WWS Crown (Werkon Web Services)

# PostgreSQL container
POSTGRES_DB=crown_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# API: connection string (host "postgres" inside docker compose, "localhost" for local IDE runs)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=crown_db;Username=postgres;Password=change-me

# API: seed admin (used only when the admin user does not exist yet)
Seed__AdminUserName=admin
Seed__AdminPassword=change-me-Strong1!
Seed__AdminDisplayName=Administrator

# Application timezone (используется и API, и Web для отображения дат)
AppTimeZone=Europe/Moscow

# Currency for the whole site: RUB (default), USD, EUR, JPY
CurrencyCode=RUB

# Обновление стека из UI отключено — обновляем вручную на хосте (git pull + docker compose up -d --build).
UPDATE_ENABLED=false
# Restart stack / reboot / shutdown host from System Status (Linux host + docker.sock)
UPDATE_HOST_POWER_ENABLED=true
# Edit host netplan from System Status (Linux VPS + docker.sock)
UPDATE_NETPLAN_ENABLED=true
# UPDATE_NETPLAN_FILE=/etc/netplan/00-installer-config.yaml

# «Связь с разработчиком» на Состоянии системы:
# 1) Telegram-бот: создай бота у @BotFather, напиши боту /start из своего чата,
#    узнай chat_id (например через @userinfobot), затем:
# SUPPORT_WEBHOOK_URL=https://api.telegram.org/bot<TOKEN>/sendMessage
# SUPPORT_TELEGRAM_CHAT_ID=123456789
# 2) Или любой HTTPS webhook (Discord/свой сервер): POST JSON { text, version, hostname, report }
# Если пусто — кнопка всё равно соберёт отчёт; клиент скачает .txt и пришлёт тебе вручную.

# Host path to this repo for Docker bind mounts (/update/repo inside api, Caddyfile for proxy).
# По умолчанию "." — каталог с docker-compose.yml. На VPS можно задать абсолютный путь к клону проекта.
# UPDATE_REPO_PATH=.

# Site hostname. First time: run docker\setup-hosts.ps1 as Administrator
APP_HOSTNAME=crown.local

# Reverse proxy (Caddy). Web и API стоят за одним хостом: /api/* -> API, остальное -> Web,
# поэтому cookie Crown.Auth общая (SameSite=Lax, path=/).
HTTP_PORT=80
HTTPS_PORT=443
CADDY_ADDRESS=crown.local
CADDY_GLOBAL_OPTIONS=auto_https off
# Production (LAN only): keep auto_https off, point internal DNS or hosts on each PC
# to the server IP, e.g. 192.168.1.50 crown.local
# CADDY_GLOBAL_OPTIONS=

# Optional: host LAN IP shown on System Status (comma-separated)
# LAN_ADDRESSES=192.168.1.50

# Вложения заявок — bind-mount на хост (не named volume), внутри api: /data/attachments.
# Иерархия: {номер_заявки}/{guid}_{имя}. Чтобы держать файлы на другом диске:
#   ATTACHMENTS_HOST_PATH=/mnt/data2/crown-attachments
# По умолчанию — каталог рядом с проектом.
ATTACHMENTS_HOST_PATH=./data/attachments
# Временно при переезде: старый каталог только для чтения (скачивание старых файлов).
# ATTACHMENTS_LEGACY_HOST_PATH=/var/lib/docker/volumes/..._crown_attachments/_data
# Миграция: scripts/migrate-attachments.sh
# Лимит файла: Attachments:MaxFileBytes в API (по умолчанию 20 МБ).

# Scheduled PostgreSQL backups (./backups on the project disk)
# Daily wall-clock time in AppTimeZone (HH:mm). Empty BACKUP_DAILY_AT = sleep INTERVAL instead.
BACKUP_DAILY_AT=03:00
BACKUP_INTERVAL_SECONDS=86400
DAILY_RETENTION_DAYS=7
WEEKLY_RETENTION_WEEKS=4

# Encrypted restic copy on a separate local disk (recommended: second physical drive)
# 1. Create a folder on the second disk, e.g. D:\CrownBackups\restic-repo
# 2. Use forward slashes in .env on Windows: D:/CrownBackups/restic-repo
# 3. Set RESTIC_REPOSITORY=/restic-repo (path inside the backup container)
RESTIC_HOST_PATH=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Стабильное имя host в restic (не ID контейнера) — иначе forget раздувается после recreate.
RESTIC_HOST_TAG=crown-server
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
