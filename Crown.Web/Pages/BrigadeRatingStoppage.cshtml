@page "/brigade-rating/stoppage/{id:guid?}"
@model BrigadeRatingStoppageModel
@{
    ViewData["Title"] = Model.IsEdit ? "Правка остановки" : "Новая остановка";
    var actItemsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ActItems.Select(a => new { id = a.Id, text = a.Text }));
}

<div class="crown-page-head">
    <h1 class="section-title">@(Model.IsEdit ? "Правка остановки" : "Новая остановка")</h1>
    <a class="btn btn-outline-secondary" href="/brigade-rating">К рейтингу</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Brigades.Count == 0)
{
    <div class="alert alert-warning">
        Нет участников рейтинга. В матрице прав поставьте галочку «Рейтинг бригад» нужным подразделениям.
    </div>
}

<form method="post" class="crown-form form-panel" id="stoppage-form">
    <input type="hidden" asp-for="Input.BrigadeNameHint" />
    <div class="transport-form-grid">
        <div class="mb-2">
            <label class="form-label" asp-for="Input.BrigadeUserId">Бригада <span class="crown-req">*</span></label>
            <select class="form-select" asp-for="Input.BrigadeUserId" id="brigade-select" required>
                <option value="">— выберите —</option>
                @foreach (var b in Model.Brigades)
                {
                    if (Model.Input.BrigadeUserId == b.Id)
                    {
                        <option value="@b.Id" selected data-name="@b.Name">@b.Name</option>
                    }
                    else
                    {
                        <option value="@b.Id" data-name="@b.Name">@b.Name</option>
                    }
                }
            </select>
        </div>
        <div class="mb-2">
            <label class="form-label" for="master-select">ФИО мастера</label>
            <input type="hidden" asp-for="Input.MasterName" id="master-name" />
            <select class="form-select" asp-for="Input.MasterPersonId" id="master-select">
                @if (Model.Input.MasterPersonId is null && !string.IsNullOrWhiteSpace(Model.Input.MasterName))
                {
                    <option value="" selected data-name="@Model.Input.MasterName">@Model.Input.MasterName (без привязки)</option>
                }
                else
                {
                    <option value="">— не выбран —</option>
                }
                @foreach (var p in Model.MasterPersonnel)
                {
                    var label = string.IsNullOrWhiteSpace(p.Position) ? p.FullName : $"{p.FullName} — {p.Position}";
                    if (Model.Input.MasterPersonId == p.Id)
                    {
                        <option value="@p.Id" selected data-name="@p.FullName">@label@(p.IsActive ? "" : " (неактивен)")</option>
                    }
                    else
                    {
                        <option value="@p.Id" data-name="@p.FullName">@label</option>
                    }
                }
            </select>
        </div>
        <div class="mb-2">
            <label class="form-label" asp-for="Input.ReportDate">Дата (отчётные сутки) <span class="crown-req">*</span></label>
            <input class="form-control" type="date" asp-for="Input.ReportDate" required />
        </div>
        <div class="mb-2">
            <label class="form-label" asp-for="Input.StoppedByUserId">Кто остановил <span class="crown-req">*</span></label>
            <select class="form-select" asp-for="Input.StoppedByUserId" id="stopped-by-dept" required>
                <option value="">— выберите подразделение —</option>
                @foreach (var u in Model.Departments)
                {
                    if (Model.Input.StoppedByUserId == u.Id)
                    {
                        <option value="@u.Id" selected data-name="@u.DisplayName">@u.DisplayName</option>
                    }
                    else
                    {
                        <option value="@u.Id" data-name="@u.DisplayName">@u.DisplayName</option>
                    }
                }
            </select>
        </div>
        <div class="mb-2">
            <label class="form-label" for="stopped-by-person">ФИО / должность</label>
            <input type="hidden" asp-for="Input.StoppedByName" id="stopped-by-name" />
            <select class="form-select" asp-for="Input.StoppedByPersonId" id="stopped-by-person">
                @if (Model.Input.StoppedByPersonId is null && !string.IsNullOrWhiteSpace(Model.Input.StoppedByName) && Model.Input.StoppedByUserId is null)
                {
                    <option value="" selected data-name="@Model.Input.StoppedByName">@Model.Input.StoppedByName (без привязки)</option>
                }
                else
                {
                    <option value="">— не выбран —</option>
                }
                @foreach (var p in Model.StopperPersonnel)
                {
                    var label = string.IsNullOrWhiteSpace(p.Position) ? p.FullName : $"{p.FullName} — {p.Position}";
                    if (Model.Input.StoppedByPersonId == p.Id)
                    {
                        <option value="@p.Id" selected data-name="@p.FullName">@label@(p.IsActive ? "" : " (неактивен)")</option>
                    }
                    else
                    {
                        <option value="@p.Id" data-name="@p.FullName">@label</option>
                    }
                }
            </select>
            <div class="form-text"><a href="/personnel">Персонал</a>: если пусто — добавьте сотрудников.</div>
        </div>
        <div class="mb-2">
            <label class="form-label" asp-for="Input.StoppedAt">Время остановки <span class="crown-req">*</span></label>
            <input class="form-control" type="time" asp-for="Input.StoppedAt" required />
        </div>
        <div class="mb-2">
            <label class="form-label" asp-for="Input.RestartedAt">Время запуска</label>
            <input class="form-control" type="time" asp-for="Input.RestartedAt" />
        </div>
        <div class="mb-2" style="grid-column: 1 / -1;">
            <div class="d-flex align-items-end justify-content-between gap-2 mb-1">
                <label class="form-label mb-0" for="work-select">Выполняемая работа</label>
                <a class="btn btn-outline-secondary btn-sm" href="/brigade-rating/work-items">Справочник</a>
            </div>
            @{
                var workManual = Model.Input.IsWorkManual || Model.Input.WorkItemId is null;
            }
            <input type="hidden" id="work-ismanual" name="Input.IsWorkManual" value="@(workManual ? "true" : "false")" />
            <div class="brigade-work-editor">
                <select class="form-select" asp-for="Input.WorkItemId" id="work-select">
                    <option value="">— Вручную —</option>
                    @foreach (var w in Model.WorkItems)
                    {
                        if (!workManual && Model.Input.WorkItemId == w.Id)
                        {
                            <option value="@w.Id" selected>@w.Text</option>
                        }
                        else
                        {
                            <option value="@w.Id">@w.Text</option>
                        }
                    }
                </select>
                <input class="form-control mt-1 @(workManual ? "" : "d-none")" asp-for="Input.WorkDescription" id="work-text"
                       placeholder="Выполняемая работа вручную" />
            </div>
        </div>
    </div>

    <div class="mb-3">
        <div class="d-flex align-items-end justify-content-between gap-2 mb-2">
            <label class="form-label mb-0">Пункты по акту <span class="crown-req">*</span></label>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary btn-sm" href="/brigade-rating/act-items">Справочник</a>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="add-remark-row">+ пункт</button>
            </div>
        </div>
        @if (Model.ActItems.Count == 0)
        {
            <p class="text-muted small mb-2">Справочник пуст — заполните пункты или выбирайте «Вручную».</p>
        }
        <div id="remarks-list" class="brigade-remark-editor">
            @for (var i = 0; i < Model.Input.Remarks.Count; i++)
            {
                var rem = Model.Input.Remarks[i];
                var isManual = rem.IsManual || rem.ActItemId is null;
                <div class="brigade-remark-editor-row" data-row="@i">
                    <input type="hidden" name="Input.Remarks[@i].Id" value="@rem.Id" />
                    <input type="hidden" class="remark-ismanual" name="Input.Remarks[@i].IsManual" value="@(isManual ? "true" : "false")" />
                    <select class="form-select remark-act" name="Input.Remarks[@i].ActItemId">
                        <option value="">— Вручную —</option>
                        @foreach (var a in Model.ActItems)
                        {
                            if (!isManual && rem.ActItemId == a.Id)
                            {
                                <option value="@a.Id" selected>@a.Text</option>
                            }
                            else
                            {
                                <option value="@a.Id">@a.Text</option>
                            }
                        }
                    </select>
                    <input class="form-control remark-text @(isManual ? "" : "d-none")"
                           name="Input.Remarks[@i].Text" value="@rem.Text" placeholder="Текст пункта вручную" />
                    <input class="form-control remark-comment @(isManual ? "d-none" : "")"
                           name="Input.Remarks[@i].Comment" value="@rem.Comment" placeholder="Комментарий (в Excel в скобках)" />
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Input.Remarks[@i].IsResolved" value="true"
                               @(rem.IsResolved ? "checked" : null) id="rem-resolved-@i" />
                        <label class="form-check-label" for="rem-resolved-@i">Выполнено</label>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm remark-remove" title="Убрать строку">×</button>
                </div>
            }
        </div>
    </div>

    <div class="crown-form-actions">
        <button type="submit" class="btn btn-save btn-lg">СОХРАНИТЬ</button>
        <a class="btn btn-outline-secondary btn-lg" href="/brigade-rating">Отмена</a>
        @if (Model.IsEdit)
        {
            <button type="submit" formaction="?handler=Delete" formmethod="post"
                    class="btn btn-outline-danger btn-lg"
                    data-confirm="Удалить эту остановку безвозвратно?">Удалить</button>
        }
    </div>
</form>

@section Scripts {
<script>
(() => {
    const list = document.getElementById('remarks-list');
    const addBtn = document.getElementById('add-remark-row');
    const actItems = @Html.Raw(actItemsJson);
    const brigadeSelect = document.getElementById('brigade-select');
    const masterName = document.getElementById('master-name');
    const masterSelect = document.getElementById('master-select');
    const stoppedByDept = document.getElementById('stopped-by-dept');
    const stoppedByName = document.getElementById('stopped-by-name');
    const stoppedByPerson = document.getElementById('stopped-by-person');

    function brigadeDisplayName() {
        return brigadeSelect?.selectedOptions[0]?.getAttribute('data-name') || '';
    }
    function deptDisplayName() {
        return stoppedByDept?.selectedOptions[0]?.getAttribute('data-name') || '';
    }
    function syncPersonName(select, hidden, fallback) {
        if (!select || !hidden) return;
        const opt = select.selectedOptions[0];
        hidden.value = select.value ? (opt?.getAttribute('data-name') || '') : (fallback || '');
    }
    masterSelect?.addEventListener('change', () => syncPersonName(masterSelect, masterName, brigadeDisplayName()));
    stoppedByPerson?.addEventListener('change', () => syncPersonName(stoppedByPerson, stoppedByName, deptDisplayName()));

    function fillPersonnelSelect(select, people, emptyLabel) {
        if (!select) return;
        select.innerHTML = `<option value="">${emptyLabel}</option>`;
        people.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p.id;
            opt.dataset.name = p.fullName;
            opt.textContent = p.position ? `${p.fullName} — ${p.position}` : p.fullName;
            select.appendChild(opt);
        });
    }

    async function loadPersonnel(ownerId, select, emptyLabel) {
        fillPersonnelSelect(select, [], emptyLabel);
        if (!ownerId) return;
        try {
            const res = await fetch(`/brigade-rating/stoppage?handler=Personnel&ownerUserId=${encodeURIComponent(ownerId)}`);
            if (!res.ok) return;
            const people = await res.json();
            fillPersonnelSelect(select, people, emptyLabel);
        } catch { /* ignore */ }
    }

    // Смена бригады → персонал мастера.
    brigadeSelect?.addEventListener('change', async () => {
        if (masterName) masterName.value = brigadeDisplayName();
        await loadPersonnel(brigadeSelect.value, masterSelect, '— не выбран —');
    });

    // Смена подразделения «кто остановил» → его персонал в ФИО.
    stoppedByDept?.addEventListener('change', async () => {
        if (stoppedByName) stoppedByName.value = deptDisplayName();
        await loadPersonnel(stoppedByDept.value, stoppedByPerson, '— не выбран —');
    });

    // Работа: из справочника или вручную (как «Вручную» у пунктов акта).
    const workSelect = document.getElementById('work-select');
    const workText = document.getElementById('work-text');
    const workManualInput = document.getElementById('work-ismanual');
    workSelect?.addEventListener('change', () => {
        const manual = !workSelect.value;
        workManualInput.value = manual ? 'true' : 'false';
        workText.classList.toggle('d-none', !manual);
        if (!manual) workText.value = '';
    });

    function syncRow(row) {
        const sel = row.querySelector('.remark-act');
        const text = row.querySelector('.remark-text');
        const comment = row.querySelector('.remark-comment');
        const isManualInput = row.querySelector('.remark-ismanual');
        const manual = !sel.value;
        isManualInput.value = manual ? 'true' : 'false';
        text.classList.toggle('d-none', !manual);
        comment.classList.toggle('d-none', manual);
        if (!manual) text.value = '';
        else comment.value = '';
    }

    function wireRow(row) {
        row.querySelector('.remark-act')?.addEventListener('change', () => syncRow(row));
        row.querySelector('.remark-remove')?.addEventListener('click', () => {
            if (list.querySelectorAll('.brigade-remark-editor-row').length <= 1) return;
            row.remove();
            reindex();
        });
    }

    function reindex() {
        [...list.querySelectorAll('.brigade-remark-editor-row')].forEach((row, i) => {
            row.dataset.row = String(i);
            row.querySelectorAll('[name]').forEach(el => {
                el.name = el.name.replace(/Input\.Remarks\[\d+]/, `Input.Remarks[${i}]`);
            });
            const cb = row.querySelector('.form-check-input');
            const lb = row.querySelector('.form-check-label');
            if (cb && lb) {
                cb.id = `rem-resolved-${i}`;
                lb.setAttribute('for', cb.id);
            }
        });
    }

    function actOptionsHtml(selected) {
        return actItems.map(a =>
            `<option value="${a.id}" ${selected === a.id ? 'selected' : ''}>${escapeHtml(a.text)}</option>`
        ).join('');
    }

    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    addBtn?.addEventListener('click', () => {
        const i = list.querySelectorAll('.brigade-remark-editor-row').length;
        const row = document.createElement('div');
        row.className = 'brigade-remark-editor-row';
        row.dataset.row = String(i);
        row.innerHTML = `
            <input type="hidden" name="Input.Remarks[${i}].Id" value="" />
            <input type="hidden" class="remark-ismanual" name="Input.Remarks[${i}].IsManual" value="false" />
            <select class="form-select remark-act" name="Input.Remarks[${i}].ActItemId">
                <option value="">— Вручную —</option>
                ${actOptionsHtml(null)}
            </select>
            <input class="form-control remark-text d-none" name="Input.Remarks[${i}].Text" value="" placeholder="Текст пункта вручную" />
            <input class="form-control remark-comment" name="Input.Remarks[${i}].Comment" value="" placeholder="Комментарий (в Excel в скобках)" />
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="Input.Remarks[${i}].IsResolved" value="true" id="rem-resolved-${i}" />
                <label class="form-check-label" for="rem-resolved-${i}">Выполнено</label>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm remark-remove" title="Убрать строку">×</button>`;
        list.appendChild(row);
        wireRow(row);
        syncRow(row);
    });

    list.querySelectorAll('.brigade-remark-editor-row').forEach(wireRow);
})();
</script>
}
