@page "/users"
@model UserListModel
@{
    ViewData["Title"] = "Пользователи";
}

<div class="crown-page-head">
    <h1 class="section-title">Пользователи</h1>
    <a class="btn btn-primary" href="/users/edit">Добавить пользователя</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="crown-table-wrap">
    <table class="table crown-table">
        <thead>
        <tr>
            <th>Логин</th>
            <th>Имя</th>
            <th>Роль</th>
            <th>Статус</th>
            <th>Активность</th>
        </tr>
        </thead>
        <tbody data-infinite-scroll
               data-more-url="@UiHelpers.BuildUrl("/users", ("handler", "More"))"
               data-skip="@Model.Items.Count"
               data-has-more="@(Model.HasMore ? "true" : "false")">
        @if (Model.Items.Count == 0 && string.IsNullOrEmpty(Model.Error))
        {
            <tr class="crown-empty-row"><td colspan="5" class="text-muted text-center">Пользователей нет.</td></tr>
        }
        else
        {
            <partial name="_UserRows" model="Model.Items" />
        }
        </tbody>
    </table>
</div>
<div class="infinite-scroll-sentinel" hidden></div>
