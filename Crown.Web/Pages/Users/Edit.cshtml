@page "/users/edit/{id:guid?}"
@model UserEditModel
@inject AppTime Time
@{
    ViewData["Title"] = Model.IsNew ? "Новый пользователь" : "Редактирование пользователя";
}

<h1 class="section-title">@(Model.IsNew ? "Новый пользователь" : "Редактирование пользователя")</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="form-panel crown-form">
    @if (!Model.IsNew && Model.LastActivityAtUtc.HasValue)
    {
        <p class="user-last-activity">
            <span>Последняя активность:</span>
            <span>@Time.FormatUtc(Model.LastActivityAtUtc)</span>
        </p>
    }

    <div class="mb-3">
        <label class="form-label" asp-for="Input.UserName">Логин</label>
        @if (Model.IsProtectedAdmin)
        {
            <div class="form-control-plaintext">@Model.Input.UserName</div>
            <input type="hidden" asp-for="Input.UserName" />
            <div class="form-text">Логин системного пользователя admin нельзя изменить.</div>
        }
        else
        {
            <input class="form-control" asp-for="Input.UserName" required autocomplete="off" />
        }
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Input.DisplayName">Имя</label>
        <input class="form-control" asp-for="Input.DisplayName" required />
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Input.Role">Роль</label>
        @if (Model.IsNew)
        {
            <select class="form-select" asp-for="Input.Role" id="user-role">
                @foreach (var r in AppRoles.All)
                {
                    <option value="@r">@AppRoles.Display(r)</option>
                }
            </select>
        }
        else if (Model.CanSwitchRole)
        {
            @* Админ свободно переключает Подразделение / Заказчик / Бригада. *@
            <select class="form-select" asp-for="Input.Role" id="user-role">
                @foreach (var r in AppRoles.Switchable)
                {
                    <option value="@r">@AppRoles.Display(r)</option>
                }
            </select>
            <div class="form-text">
                Можно менять между «Подразделение», «Заказчик» и «Бригада».
                При уходе с «Бригады» номер и цех очищаются, при уходе с «Подразделения» — заголовок документации.
            </div>
        }
        else
        {
            <div class="form-control-plaintext">@AppRoles.Display(Model.Input.Role)</div>
            <input type="hidden" asp-for="Input.Role" />
            <div class="form-text">
                @(Model.IsProtectedAdmin
                    ? "Роль системного пользователя admin нельзя изменить."
                    : "Эту роль менять нельзя. Нужна другая роль — создайте нового пользователя.")
            </div>
        }
    </div>

    @{
        var effectiveRole = Model.Input.Role ?? AppRoles.Department;
        var showDocTitle = effectiveRole == AppRoles.Department;
        var showBrigade = effectiveRole == AppRoles.Brigade;
    }
    <div class="mb-3 @(showDocTitle ? null : "d-none")" id="user-doc-title-wrap">
        <label class="form-label" asp-for="Input.DocumentationTitle">Заголовок в документации</label>
        <input class="form-control" asp-for="Input.DocumentationTitle" maxlength="200" />
        <div class="form-text">Только для роли «Подразделение». Если пусто — в документации показывается имя.</div>
    </div>

    <div class="@(showBrigade ? null : "d-none")" id="user-brigade-wrap">
        <div class="mb-3">
            <label class="form-label" asp-for="Input.BrigadeNumber">Номер бригады</label>
            <input class="form-control" asp-for="Input.BrigadeNumber" maxlength="50" id="user-brigade-number" />
            <div class="form-text">Обязателен для роли «Бригада». В списках имя выводится как «Имя №номер».</div>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Input.BrigadeWorkshop">Цех</label>
            <input class="form-control" asp-for="Input.BrigadeWorkshop" maxlength="100" id="user-brigade-workshop" />
            <div class="form-text">Обязателен для роли «Бригада».</div>
        </div>
    </div>

    @if (!Model.IsNew && !Model.IsSelf && !Model.IsProtectedAdmin)
    {
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" asp-for="Input.IsActive" id="user-is-active" />
            <label class="form-check-label" for="user-is-active" asp-for="Input.IsActive">Учётная запись активна</label>
            <div class="form-text">Отключённый пользователь не может войти в систему.</div>
        </div>
    }
    else
    {
        <input type="hidden" asp-for="Input.IsActive" />
    }

    @if (Model.IsSelf)
    {
        <div class="mb-3">
            <label class="form-label" asp-for="Input.CurrentPassword">Текущий пароль</label>
            <input class="form-control" type="password" asp-for="Input.CurrentPassword" autocomplete="current-password" />
            <div class="form-text">Нужен только если меняете свой пароль.</div>
        </div>
    }

    <div class="mb-3">
        <label class="form-label" asp-for="Input.Password">@(Model.IsSelf ? "Новый пароль" : "Пароль")</label>
        <input class="form-control" type="password" asp-for="Input.Password" autocomplete="new-password" />
        @if (Model.IsNew)
        {
            <div class="form-text">Минимум 8 символов, в том числе строчная буква и цифра.</div>
        }
        else
        {
            <div class="form-text">Оставьте пустым, если пароль менять не нужно.</div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Input.ConfirmPassword">@(Model.IsSelf ? "Подтверждение нового пароля" : "Подтверждение пароля")</label>
        <input class="form-control" type="password" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
    </div>

    <div class="crown-form-actions">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a class="btn btn-secondary" href="/users">Отмена</a>
    </div>
</form>

@if (Model.IsNew || Model.CanSwitchRole)
{
    @section Scripts {
    <script>
    (() => {
        const role = document.getElementById('user-role');
        const docWrap = document.getElementById('user-doc-title-wrap');
        const brigadeWrap = document.getElementById('user-brigade-wrap');
        const brigadeNumber = document.getElementById('user-brigade-number');
        const brigadeWorkshop = document.getElementById('user-brigade-workshop');
        if (!role || !docWrap || !brigadeWrap) return;
        const departmentRole = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppRoles.Department));
        const brigadeRole = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AppRoles.Brigade));
        const sync = () => {
            const isBrigade = role.value === brigadeRole;
            docWrap.classList.toggle('d-none', role.value !== departmentRole);
            brigadeWrap.classList.toggle('d-none', !isBrigade);
            // required только когда поля видны (иначе браузер блокирует submit скрытых полей).
            if (brigadeNumber) brigadeNumber.required = isBrigade;
            if (brigadeWorkshop) brigadeWorkshop.required = isBrigade;
        };
        role.addEventListener('change', sync);
        sync();
    })();
    </script>
    }
}
