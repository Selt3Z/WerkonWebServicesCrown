@page "/settings/documentation-access"
@model DocumentationAccessModel
@{
    ViewData["Title"] = "Доступ к документации";
    var memberSet = Model.Members.Select(x => x.UserId).ToHashSet();
    var writeSet = Model.Members.Where(x => x.CanWrite).Select(x => x.UserId).ToHashSet();
}

<div class="crown-page-head">
    <h1 class="section-title">Доступ к каталогам документации</h1>
    <a class="btn btn-outline-secondary" href="/documentation">К документации</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<p class="text-muted mb-3">
    Членство = чтение каталога. Галочка «Запись» — загрузка/правка/корзина.
    Общий вход в раздел включается матрицей прав (Документация).
</p>

<form method="get" class="list-filters mb-3">
    <div class="filter-field filter-field-inline">
        <label class="form-label" for="lib-pick">Каталог</label>
        <select id="lib-pick" class="form-select" name="LibraryId" onchange="this.form.submit()">
            @foreach (var lib in Model.Libraries)
            {
                <option value="@lib.Id" selected="@(lib.Id == Model.LibraryId)">@lib.Name</option>
            }
        </select>
    </div>
</form>

@if (Model.LibraryId is Guid)
{
    <form method="post" asp-page-handler="SaveMembers" class="mb-4">
        <input type="hidden" name="LibraryId" value="@Model.LibraryId" />
        <div class="crown-table-wrap">
            <table class="table crown-table">
                <thead>
                <tr>
                    <th>Участник</th>
                    <th class="num">Чтение</th>
                    <th class="num">Запись</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var u in Model.Users)
                {
                    var isMember = memberSet.Contains(u.UserId);
                    var canWrite = writeSet.Contains(u.UserId);
                    <tr>
                        <td>
                            @u.DisplayName
                            <span class="text-muted">(@u.UserName)</span>
                        </td>
                        <td class="num">
                            <input class="form-check-input" type="checkbox" name="MemberUserIds" value="@u.UserId"
                                   @(isMember ? "checked" : null) />
                        </td>
                        <td class="num">
                            <input class="form-check-input" type="checkbox" name="WriteUserIds" value="@u.UserId"
                                   @(canWrite ? "checked" : null) />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Сохранить участников</button>
    </form>
}

<section class="mb-4">
    <h2 class="h5">Перенос старых разделов</h2>
    <p class="text-muted">
        Файлы/папки без LibraryId (бывший OwnerUserId) → выбранный каталог.
        Владельцу добавляется CanWrite; InboxFolderKey берётся из логина, если пуст.
    </p>
    @if (Model.Legacy is null || Model.Legacy.Items.Count == 0)
    {
        <p class="text-muted">Неперенесённых источников нет.</p>
    }
    else
    {
        <form method="post" asp-page-handler="Migrate" class="d-flex flex-wrap gap-2 align-items-end">
            <input type="hidden" name="LibraryId" value="@Model.LibraryId" />
            <div class="filter-field filter-field-inline">
                <label class="form-label" for="mig-owner">Источник</label>
                <select id="mig-owner" class="form-select" name="MigrateOwnerUserId" required>
                    <option value="">— выберите —</option>
                    @foreach (var src in Model.Legacy.Items)
                    {
                        <option value="@src.OwnerUserId">
                            @src.DisplayName (@src.UserName) — папок @src.FolderCount, файлов @src.FileCount
                        </option>
                    }
                </select>
            </div>
            <div class="filter-field filter-field-inline">
                <label class="form-label" for="mig-lib">Каталог</label>
                <select id="mig-lib" class="form-select" name="MigrateLibraryId" required>
                    <option value="">— выберите —</option>
                    @foreach (var lib in Model.Libraries)
                    {
                        <option value="@lib.Id">@lib.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-warning"
                    data-confirm="Перенести все файлы/папки выбранного владельца в каталог?">Перенести</button>
        </form>
    }
</section>
