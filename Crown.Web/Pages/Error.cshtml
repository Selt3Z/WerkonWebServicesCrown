@page "/error"
@model ErrorModel
@{
    ViewData["Title"] = "Ошибка";
    Layout = "_LoginLayout";
}

<div class="login-card">
    <h1 class="section-title">Что-то пошло не так</h1>
    <p>Внутренняя ошибка сервера. Повторите действие или вернитесь на главную.</p>
    <a class="btn btn-primary" href="/">На главную</a>
</div>
