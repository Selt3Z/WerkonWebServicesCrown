@page "/login"
@model LoginModel
@{
    ViewData["Title"] = "Вход";
    Layout = "_LoginLayout";
}

<div class="login-card">
    <div class="login-logo-wrap">
        <img class="login-logo crown-login-full" src="~/images/fulllogo.png" alt="WWS Crown" />
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger login-alert-block">@Model.Error</div>
    }

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3">
            <label class="form-label" asp-for="UserName">Логин</label>
            <input class="form-control" asp-for="UserName" autocomplete="username" autofocus />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Password">Пароль</label>
            <input class="form-control" type="password" asp-for="Password" autocomplete="current-password" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Войти</button>
    </form>
</div>
