@page "/requests/new"
@model Crown.Web.Pages.Requests.NewModel
@{
    ViewData["Title"] = "Подать заявку";
}

<h1 class="section-title">Подать заявку</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" enctype="multipart/form-data" class="crown-form form-panel">
    <div class="mb-3">
        <label class="form-label">Тип заявки</label>
        <div class="d-flex flex-wrap gap-3">
            @if (Model.CanCreateTransport)
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Input.Kind" value="@((int)ServiceRequestKind.SpecTech)" id="kind-spec" />
                    <label class="form-check-label" for="kind-spec">Запрос спецтехники</label>
                </div>
            }
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="Input.Kind" value="@((int)ServiceRequestKind.Equipment)" id="kind-eq" />
                <label class="form-check-label" for="kind-eq">Запрос оборудования</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="Input.Kind" value="@((int)ServiceRequestKind.Other)" id="kind-other" />
                <label class="form-check-label" for="kind-other">Другое</label>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Срочность</label>
        <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="Input.IsUrgent" value="false" id="urg-plan" checked="@(!Model.Input.IsUrgent)" />
                <label class="form-check-label" for="urg-plan">Плановая</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="Input.IsUrgent" value="true" id="urg-fast" checked="@Model.Input.IsUrgent" />
                <label class="form-check-label" for="urg-fast">Срочная</label>
            </div>
        </div>
    </div>

    <div class="crown-form-grid">
        <div class="mb-3">
            <label class="form-label" asp-for="Input.Phone">Телефон <span class="crown-req">*</span></label>
            <input class="form-control" type="tel" asp-for="Input.Phone" required autocomplete="tel"
                   placeholder="+7 912 345-67-89" />
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Input.DueAt">Срок исполнения <span class="crown-req">*</span></label>
            <input class="form-control" type="datetime-local" asp-for="Input.DueAt" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Инициатор <span class="crown-req">*</span></label>
            @if (Model.CanPickInitiator)
            {
                <select class="form-select" asp-for="Input.InitiatorUserId" required>
                    <option value="">— выберите —</option>
                    @foreach (var u in Model.Assignees)
                    {
                        <option value="@u.Id">@u.DisplayName (@u.UserName)</option>
                    }
                </select>
            }
            else
            {
                <input class="form-control form-control-locked" value="@Model.CurrentUserDisplayName" readonly tabindex="-1" />
            }
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Input.ExecutorUserId">Исполнитель <span class="crown-req">*</span></label>
            <select class="form-select" asp-for="Input.ExecutorUserId" id="executor-user" required>
                <option value="">— выберите —</option>
                @foreach (var u in Model.Assignees)
                {
                    <option value="@u.Id">@u.DisplayName (@u.UserName)</option>
                }
            </select>
        </div>
    </div>

    <div class="mb-3" id="equipment-wrap" hidden>
        <label class="form-label" asp-for="Input.EquipmentAssetId">Единица оборудования <span class="crown-req">*</span></label>
        <select class="form-select" asp-for="Input.EquipmentAssetId" id="equipment-asset">
            <option value="">— выберите свободную —</option>
            @foreach (var a in Model.FreeEquipment)
            {
                <option value="@a.Id">@a.Name (@a.InventoryNumber)@(string.IsNullOrWhiteSpace(a.CurrentLocationLabel) ? "" : $" · {a.CurrentLocationLabel}")</option>
            }
        </select>
    </div>

    <div id="spectech-wrap" hidden>
        <div class="mb-3">
            <label class="form-label" asp-for="Input.SpecialVehicleUnitId">Спецтехника <span class="crown-req">*</span></label>
            <select class="form-select" asp-for="Input.SpecialVehicleUnitId" id="spec-unit">
                <option value="">— выберите свободную —</option>
                @foreach (var u in Model.FreeSpecUnits)
                {
                    <option value="@u.Id">@u.Name@(string.IsNullOrWhiteSpace(u.PlateOrNote) ? "" : $" ({u.PlateOrNote})")</option>
                }
            </select>
            @if (Model.SpecTypeAvailability.Count > 0)
            {
                <div class="form-text">
                    Свободно по типу:
                    @string.Join("; ", Model.SpecTypeAvailability.Select(t => $"{t.Name}: {t.FreeCount}/{t.TotalActive}"))
                </div>
            }
        </div>
        <div class="crown-form-grid">
            <div class="mb-3">
                <label class="form-label" asp-for="Input.SpecOperation">Операция <span class="crown-req">*</span></label>
                <input class="form-control" asp-for="Input.SpecOperation" />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.SpecPlannedAt">Плановое время <span class="crown-req">*</span></label>
                <input class="form-control" type="datetime-local" asp-for="Input.SpecPlannedAt" />
            </div>
        </div>
    </div>

    <div class="mb-3" id="body-mode-wrap" hidden>
        <label class="form-label" asp-for="Input.BodyMode">Текст заявки</label>
        <select class="form-select" asp-for="Input.BodyMode" id="body-mode">
            <option value="manual">Вручную</option>
            <option value="catalog">Из каталога исполнителя</option>
        </select>
    </div>

    <div class="mb-3" id="catalog-service-wrap" hidden>
        <label class="form-label" for="catalog-service">Услуга/узел из каталога</label>
        <select class="form-select" id="catalog-service" asp-for="Input.CatalogPartId">
            <option value="">— выберите услугу/узел —</option>
        </select>
        <div class="form-text">Список — активные услуги/узлы из каталога выбранного исполнителя.</div>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Input.Body">Заявка <span class="crown-req">*</span></label>
        <textarea class="form-control" asp-for="Input.Body" id="request-body" rows="8" required></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label" for="Files">Вложения</label>
        <input class="form-control" type="file" id="Files" name="Files" multiple />
        <div class="form-text">Файлы до 20 МБ каждый. Можно добавить позже на странице заявки.</div>
    </div>

    <div class="crown-form-actions">
        <button type="submit" class="btn btn-save btn-lg">СОХРАНИТЬ</button>
        <a class="btn btn-outline-secondary btn-lg" href="/">Отмена</a>
    </div>
</form>

<script>
(function () {
  var modeWrap = document.getElementById('body-mode-wrap');
  var mode = document.getElementById('body-mode');
  var wrap = document.getElementById('catalog-service-wrap');
  var executor = document.getElementById('executor-user');
  var service = document.getElementById('catalog-service');
  var body = document.getElementById('request-body');
  var due = document.getElementById('Input_DueAt') || document.querySelector('[name="Input.DueAt"]');
  var eqWrap = document.getElementById('equipment-wrap');
  var specWrap = document.getElementById('spectech-wrap');
  var cache = {};
  var hasCatalog = false;

  function kindValue() {
    var checked = document.querySelector('input[name="Input.Kind"]:checked');
    return checked ? checked.value : '0';
  }

  function syncKind() {
    var k = kindValue();
    eqWrap.hidden = k !== '1';
    specWrap.hidden = k !== '2';
  }

  document.querySelectorAll('input[name="Input.Kind"]').forEach(function (el) {
    el.addEventListener('change', syncKind);
  });
  syncKind();

  function setCatalogVisible(show) {
    hasCatalog = !!show;
    modeWrap.hidden = !show;
    if (!show) {
      mode.value = 'manual';
      wrap.hidden = true;
      service.innerHTML = '<option value="">— выберите услугу/узел —</option>';
      return;
    }
    syncMode();
  }

  function syncMode() {
    var fromCatalog = mode.value === 'catalog';
    wrap.hidden = !fromCatalog;
    body.readOnly = fromCatalog;
    if (!fromCatalog) body.removeAttribute('readonly');
  }

  mode.addEventListener('change', syncMode);

  function fillServices(items) {
    service.innerHTML = '<option value="">— выберите услугу/узел —</option>';
    (items || []).forEach(function (x) {
      var opt = document.createElement('option');
      opt.value = x.id;
      opt.textContent = x.name + (x.code ? ' (' + x.code + ')' : '');
      opt.dataset.description = x.description || '';
      opt.dataset.slaHours = x.slaHours || '';
      service.appendChild(opt);
    });
  }

  function loadServices() {
    var id = executor.value;
    if (!id) { setCatalogVisible(false); return; }
    if (cache[id]) {
      fillServices(cache[id]);
      setCatalogVisible(cache[id].length > 0);
      return;
    }
    fetch('/requests/new?handler=ServicesJson&ownerUserId=' + encodeURIComponent(id), { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : []; })
      .then(function (items) {
        cache[id] = items || [];
        fillServices(cache[id]);
        setCatalogVisible(cache[id].length > 0);
      })
      .catch(function () { setCatalogVisible(false); });
  }

  executor.addEventListener('change', loadServices);
  loadServices();

  service.addEventListener('change', function () {
    var opt = service.selectedOptions[0];
    if (!opt || !opt.value) return;
    var desc = opt.dataset.description || '';
    body.value = desc ? (opt.textContent + '\n' + desc) : opt.textContent;
    var hours = parseInt(opt.dataset.slaHours || '', 10);
    if (hours > 0 && due) {
      var d = new Date();
      d.setHours(d.getHours() + hours);
      var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
      due.value = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
        + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }
  });
})();
</script>
