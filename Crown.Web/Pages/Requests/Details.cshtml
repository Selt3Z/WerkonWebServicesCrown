@page "/requests/{id:long}"
@model Crown.Web.Pages.Requests.DetailsModel
@inject AppTime Time
@{
    var item = Model.Item;
    ViewData["Title"] = item is null ? "Заявка" : $"Заявка № {item.Id}";
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (item is null)
{
    <a class="btn btn-outline-secondary" href="/">&larr; К списку</a>
    return;
}

@{
    var actions = Model.CanManage ? DetailsModel.ActionsFor(item.Status) : [];
    // Комментарий после неудачной отправки возвращаем в поле как ввёл пользователь.
    var comment = Model.CommentInput ?? item.ExecutorComment;
}

<div class="crown-page-head">
    <h1 class="section-title">Заявка № @item.Id</h1>
    <a class="btn btn-outline-secondary" href="/">&larr; К списку</a>
</div>

@* «Опер.» — отдельная форма: нельзя вкладывать в форму переходов статусов. *@
<div class="form-panel crown-op-panel">
    <div class="crown-op-row">
        <span class="crown-op-label" title="Диспетчер ознакомился с заявкой (не workflow-статус)">Опер.</span>
        <span class="visit-payment-dot @(item.Acknowledged ? "visit-payment-dot-paid" : "visit-payment-dot-unpaid")"
              title="@(item.Acknowledged ? "Ознакомлен" : "Не отмечено")"
              aria-hidden="true"></span>
        <span>@(item.Acknowledged ? "Ознакомлен" : "Не отмечено")</span>
        @if (Model.CanManage)
        {
            <form method="post" asp-page-handler="Ack" asp-route-id="@item.Id" class="crown-op-form">
                <input type="hidden" name="ack" value="@((!item.Acknowledged).ToString().ToLowerInvariant())" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    @(item.Acknowledged ? "Снять отметку" : "Отметить ознакомление")
                </button>
            </form>
        }
    </div>
</div>

<form method="post" asp-page-handler="Transition" asp-route-id="@item.Id" class="form-panel crown-detail">
    <input type="hidden" name="rowVersion" value="@item.RowVersion" />

    <dl class="crown-dl">
        <dt>Состояние</dt>
        <dd><span class="crown-status-pill @UiHelpers.StatusClass(item.Status)">@item.StatusLabel</span></dd>

        <dt>Дата подачи</dt>
        <dd>@Time.Format(item.SubmittedAt)</dd>

        <dt>Срок исполнения</dt>
        <dd>@Time.Format(item.DueAt)</dd>

        <dt>Инициатор</dt>
        <dd>@item.InitiatorName</dd>

        <dt>Телефон</dt>
        <dd>@item.Phone</dd>

        <dt>Исполнитель</dt>
        <dd>@item.DepartmentName</dd>

        <dt>Реакция</dt>
        <dd>@Time.Format(item.ReactionAt)</dd>

        <dt>Дата исполнения</dt>
        <dd>@Time.Format(item.CompletedAt)</dd>
    </dl>

    <div class="mb-3">
        <label class="form-label">Заявка</label>
        <div class="crown-body">@item.Body</div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="executorComment">Комментарий исполнителя</label>
        @if (actions.Count > 0)
        {
            <textarea class="form-control" id="executorComment" name="executorComment" rows="4">@comment</textarea>
        }
        else
        {
            <div class="crown-body">@(string.IsNullOrWhiteSpace(item.ExecutorComment) ? "—" : item.ExecutorComment)</div>
        }
    </div>

    @if (actions.Contains("reschedule"))
    {
        <div class="mb-3 crown-reschedule">
            <label class="form-label" for="newDueAt">Новый срок (для переноса срока; комментарий обязателен)</label>
            <input class="form-control" type="datetime-local" id="newDueAt" name="newDueAt"
                   value="@(Model.NewDueInput ?? Time.ToInput(item.DueAt))" />
        </div>
    }

    @if (actions.Count > 0)
    {
        <div class="crown-actions">
            @if (actions.Contains("accept"))
            {
                <button type="submit" name="action" value="accept" class="btn btn-act btn-act-accept">ПРИНЯТЬ В РАБОТУ</button>
            }
            @if (actions.Contains("complete"))
            {
                <button type="submit" name="action" value="complete" class="btn btn-act btn-act-accept"
                        data-confirm="Завершить заявку?">ЗАВЕРШИТЬ</button>
            }
            @if (actions.Contains("reject"))
            {
                <button type="submit" name="action" value="reject" class="btn btn-act btn-act-reject"
                        data-confirm="Отклонить заявку?">ОТКЛОНИТЬ</button>
            }
            @if (actions.Contains("return"))
            {
                <button type="submit" name="action" value="return" class="btn btn-act btn-act-return">ВЕРНУТЬ</button>
            }
            @if (actions.Contains("reschedule"))
            {
                <button type="submit" name="action" value="reschedule" class="btn btn-act btn-act-reschedule">ПЕРЕНОС СРОКА</button>
            }
            @if (actions.Contains("cancel"))
            {
                <button type="submit" name="action" value="cancel" class="btn btn-act btn-act-cancel"
                        data-confirm="Отменить заявку?">ОТМЕНА</button>
            }
        </div>
    }
</form>

<section class="form-panel crown-attachments">
    <h2 class="section-subtitle">Вложения</h2>

    @if (item.Attachments.Count == 0)
    {
        <p class="text-muted">Файлов нет.</p>
    }
    else
    {
        <table class="table crown-table">
            <thead>
            <tr><th>Файл</th><th>Размер</th><th>Загружен</th></tr>
            </thead>
            <tbody>
            @foreach (var a in item.Attachments)
            {
                <tr>
                    <td>
                        <a href="/requests/@item.Id?handler=Download&amp;attachmentId=@a.Id" download>@a.FileName</a>
                    </td>
                    <td class="nowrap">@UiHelpers.FormatBytes(a.SizeBytes)</td>
                    <td class="nowrap">@Time.Format(a.UploadedAt)</td>
                </tr>
            }
            </tbody>
        </table>
    }

    <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" asp-route-id="@item.Id" class="crown-upload">
        <input class="form-control" type="file" name="file" required />
        <button type="submit" class="btn btn-primary">Загрузить</button>
    </form>
</section>
