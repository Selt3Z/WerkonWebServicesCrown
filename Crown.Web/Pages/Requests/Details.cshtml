@page "/requests/{id:long}"
@model Crown.Web.Pages.Requests.DetailsModel
@inject AppTime Time
@{
    var item = Model.Item;
    ViewData["Title"] = item is null ? "Заявка" : $"Заявка № {item.Id}";
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (item is null)
{
    <a class="btn btn-outline-secondary" href="/">&larr; К списку</a>
    return;
}

@{
    var isAdmin = User.IsInRole(AppRoles.Administrator);
    var actions = Model.CanManage ? DetailsModel.ActionsFor(item.Status, isAdmin) : [];
    var comment = Model.CommentInput ?? item.ExecutorComment;
    var showCancel = actions.Contains("cancel") || Model.CanCancelAsInitiator;
    var terminal = actions.Count == 0 && Model.CanManage && !isAdmin
                   && !Model.CanCancelAsInitiator && !Model.CanResubmit;
}

<div class="detail-page">
    <div class="entity-panel">
        <div class="entity-header">
            <div class="entity-header-leading">
                @if (item.HasComplaint)
                {
                    <span class="crown-warn-badge" title="По заявке подана жалоба" aria-label="Жалоба">!</span>
                }
                <h2 class="section-title">Заявка № @item.Id</h2>
                @if (item.IsArchived)
                {
                    <span class="badge bg-secondary">архив</span>
                }
                <div class="entity-header-actions">
                    @if (Model.CanArchive)
                    {
                        <form method="post" asp-page-handler="Archive" asp-route-id="@item.Id" class="crown-op-form">
                            <input type="hidden" name="archive" value="@((!item.IsArchived).ToString().ToLowerInvariant())" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                    data-confirm="@(item.IsArchived ? "Вернуть заявку из архива?" : "Отправить заявку в архив?")">
                                @(item.IsArchived ? "Из архива" : "В архив")
                            </button>
                        </form>
                    }
                    @if (Model.CanHardDelete)
                    {
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="crown-op-form">
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    data-confirm="Удалить заявку № @item.Id безвозвратно? Файлы тоже удалятся.">
                                Удалить
                            </button>
                        </form>
                    }
                    <a class="btn btn-sm btn-outline-secondary" href="/">&larr; К списку</a>
                </div>
            </div>
            <div class="entity-header-trailing">
                @if (Model.CanToggleAck)
                {
                    <form method="post" asp-page-handler="Ack" asp-route-id="@item.Id" class="crown-op-form">
                        <input type="hidden" name="ack" value="@((!item.Acknowledged).ToString().ToLowerInvariant())" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(item.Acknowledged ? "Снять" : "Отметить")
                        </button>
                    </form>
                }
                @* Светофор ознакомления — как VisitPaymentStatusDot в правом углу карточки сделки. *@
                <span class="visit-payment-dot @(item.Acknowledged ? "visit-payment-dot-paid" : "visit-payment-dot-unpaid")"
                      title="@Time.AckTitle(item.Acknowledged, item.AcknowledgedAt)"
                      aria-label="@Time.AckTitle(item.Acknowledged, item.AcknowledgedAt)"></span>
            </div>
        </div>

        <form method="post" asp-page-handler="Transition" asp-route-id="@item.Id" class="crown-entity-form">
            <input type="hidden" name="rowVersion" value="@item.RowVersion" />

            <dl class="entity-meta visit-entity-meta">
                <div class="entity-meta-item">
                    <dt>Статус</dt>
                    <dd><span class="crown-status-pill @UiHelpers.StatusClass(item.Status)">@item.StatusLabel</span></dd>
                </div>
                <div class="entity-meta-item">
                    <dt>Дата подачи</dt>
                    <dd>@Time.Format(item.SubmittedAt)</dd>
                </div>
                <div class="entity-meta-item">
                    <dt>Срок исполнения</dt>
                    <dd>@Time.Format(item.DueAt)</dd>
                </div>
                <div class="entity-meta-item">
                    <dt>Инициатор</dt>
                    <dd>@item.InitiatorName</dd>
                </div>
                <div class="entity-meta-item">
                    <dt>Тип</dt>
                    <dd>
                        @item.KindLabel
                        @if (item.IsUrgent)
                        {
                            <span class="badge text-bg-warning ms-1">срочная</span>
                        }
                    </dd>
                </div>
                <div class="entity-meta-item">
                    <dt>Телефон</dt>
                    <dd>@UiHelpers.FormatPhone(item.Phone)</dd>
                </div>
                <div class="entity-meta-item">
                    <dt>Исполнитель</dt>
                    <dd>@(string.IsNullOrWhiteSpace(item.ExecutorName) ? "—" : item.ExecutorName)</dd>
                </div>
                @if (item.Kind == ServiceRequestKind.Equipment)
                {
                    <div class="entity-meta-item">
                        <dt>Категория</dt>
                        <dd>@(item.RequestedEquipmentCategory ?? "—")</dd>
                    </div>
                    <div class="entity-meta-item entity-meta-wide">
                        <dt>Единица</dt>
                        <dd>
                            @if (item.EquipmentAssetId is Guid eid)
                            {
                                <a href="/equipment/@eid">@(item.EquipmentAssetLabel ?? eid.ToString())</a>
                            }
                            else
                            {
                                <text>ещё не назначена</text>
                            }
                        </dd>
                    </div>
                }
                @if (item.Kind == ServiceRequestKind.SpecTech)
                {
                    <div class="entity-meta-item">
                        <dt>Тип</dt>
                        <dd>@(item.RequestedSpecialVehicleType ?? "—")</dd>
                    </div>
                    <div class="entity-meta-item">
                        <dt>Единица</dt>
                        <dd>@(item.SpecialVehicleLabel ?? "ещё не назначена")</dd>
                    </div>
                    <div class="entity-meta-item">
                        <dt>Операция</dt>
                        <dd>@(item.SpecOperation ?? "—")</dd>
                    </div>
                    <div class="entity-meta-item">
                        <dt>План</dt>
                        <dd>@Time.Format(item.SpecPlannedAt)</dd>
                    </div>
                    <div class="entity-meta-item">
                        <dt>Прибытие</dt>
                        <dd>@Time.Format(item.SpecArrivedAt)</dd>
                    </div>
                    <div class="entity-meta-item">
                        <dt>Освобождение</dt>
                        <dd>@Time.Format(item.SpecReleasedAt)</dd>
                    </div>
                }
                <div class="entity-meta-item">
                    <dt>Реакция</dt>
                    <dd>@Time.Format(item.ReactionAt)</dd>
                </div>
                <div class="entity-meta-item">
                    <dt>Дата исполнения</dt>
                    <dd>@Time.Format(item.CompletedAt)</dd>
                </div>
                <div class="entity-meta-item">
                    <dt>Ознакомление</dt>
                    <dd>@Time.AckTitle(item.Acknowledged, item.AcknowledgedAt)</dd>
                </div>

                <div class="entity-meta-item entity-meta-wide">
                    <dt>Заявка</dt>
                    <dd>
                        @if (Model.CanResubmit)
                        {
                            <textarea class="form-control" id="body" name="body" rows="8" required
                                      placeholder="Исправьте текст и подайте заявку снова">@(Model.BodyInput ?? item.Body)</textarea>
                        }
                        else
                        {
                            <div class="crown-body">@item.Body</div>
                        }
                    </dd>
                </div>

                <div class="entity-meta-item entity-meta-wide">
                    <dt>Комментарий исполнителя</dt>
                    <dd>
                        @if (actions.Count > 0)
                        {
                            <textarea class="form-control" id="executorComment" name="executorComment" rows="4"
                                      placeholder="Обязателен для возврата, отклонения и переноса срока">@comment</textarea>
                        }
                        else
                        {
                            <div class="crown-body">@(string.IsNullOrWhiteSpace(item.ExecutorComment) ? "—" : item.ExecutorComment)</div>
                        }
                    </dd>
                </div>

                @if (actions.Contains("reschedule"))
                {
                    <div class="entity-meta-item entity-meta-wide crown-reschedule">
                        <dt>Новый срок</dt>
                        <dd>
                            <input class="form-control" type="datetime-local" id="newDueAt" name="newDueAt"
                                   value="@(Model.NewDueInput ?? Time.ToInput(item.DueAt))" />
                            <div class="form-text">Для переноса; комментарий обязателен.</div>
                        </dd>
                    </div>
                }
            </dl>

            @if (item.QueueAheadCount > 0
                && item.Status is ServiceRequestStatus.Submitted or ServiceRequestStatus.Returned)
            {
                <div class="alert alert-info mt-2 mb-0">
                    В очереди впереди ещё @item.QueueAheadCount
                    @(item.QueueAheadCount == 1 ? "заявка" : "заявок") того же типа/категории (по времени подачи).
                </div>
            }

            @if (Model.NeedsEquipmentAssignment)
            {
                <div class="mb-3 mt-3">
                    <label class="form-label" for="equipmentAssetId">Назначить оборудование <span class="crown-req">*</span></label>
                    <select class="form-select" id="equipmentAssetId" name="equipmentAssetId" required>
                        <option value="">— свободная единица категории «@(item.RequestedEquipmentCategory)» —</option>
                        @foreach (var a in Model.AssignableEquipment)
                        {
                            <option value="@a.Id">@a.Name (@a.InventoryNumber)</option>
                        }
                    </select>
                    @if (Model.AssignableEquipment.Count == 0)
                    {
                        <div class="form-text text-danger">Сейчас нет свободных единиц этой категории — принять нельзя.</div>
                    }
                </div>
            }

            @if (Model.CanAssignSpec)
            {
                <div class="mb-3 mt-3">
                    <label class="form-label" for="specialVehicleUnitId">Спецтехника</label>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <select class="form-select flex-grow-1" id="specialVehicleUnitId" name="specialVehicleUnitId">
                            <option value="">— свободная единица типа «@(item.RequestedSpecialVehicleType)» —</option>
                            @foreach (var u in Model.AssignableSpecUnits)
                            {
                                <option value="@u.Id">@u.Name@(string.IsNullOrWhiteSpace(u.PlateOrNote) ? "" : $" ({u.PlateOrNote})")</option>
                            }
                        </select>
                        <button type="submit" name="action" value="assign-spec" class="btn btn-outline-primary text-nowrap"
                                disabled="@(Model.AssignableSpecUnits.Count == 0)">Назначить спецтехнику</button>
                    </div>
                    @if (Model.AssignableSpecUnits.Count == 0)
                    {
                        <div class="form-text text-warning">Сейчас нет свободных единиц этого типа — принять в работу можно, назначить позже.</div>
                    }
                </div>
            }

            <div class="crown-actions mt-3">
                @if (actions.Contains("accept"))
                {
                    var acceptBlocked = Model.NeedsEquipmentAssignment && Model.AssignableEquipment.Count == 0;
                    <button type="submit" name="action" value="accept" class="btn btn-act btn-act-accept"
                            disabled="@acceptBlocked">Принять в работу</button>
                }
                @if (Model.CanSpecArrive)
                {
                    <button type="submit" name="action" value="spec-arrive" class="btn btn-act btn-act-accept">Прибыла</button>
                }
                @if (Model.CanSpecRelease)
                {
                    <button type="submit" name="action" value="spec-release" class="btn btn-act btn-act-accept"
                            data-confirm="Отметить освобождение спецтехники?">Освободилась</button>
                }
                @if (actions.Contains("complete"))
                {
                    <button type="submit" name="action" value="complete" class="btn btn-act btn-act-accept"
                            data-confirm="Завершить заявку?">Завершить</button>
                }
                @if (actions.Contains("reject"))
                {
                    <button type="submit" name="action" value="reject" class="btn btn-act btn-act-reject"
                            data-confirm="Отклонить заявку? Нужен комментарий.">Отклонить</button>
                }
                @if (actions.Contains("return"))
                {
                    <button type="submit" name="action" value="return" class="btn btn-act btn-act-return"
                            data-confirm="Вернуть заявку инициатору? Нужен комментарий.">Вернуть</button>
                }
                @if (actions.Contains("reschedule"))
                {
                    <button type="submit" name="action" value="reschedule" class="btn btn-act btn-act-reschedule">Перенос срока</button>
                }
                @if (Model.CanResubmit)
                {
                    <button type="submit" name="action" value="resubmit" class="btn btn-act btn-act-accept">Подать снова</button>
                }
                @if (showCancel)
                {
                    <button type="submit" name="action" value="cancel" class="btn btn-act btn-act-cancel"
                            data-confirm="Отменить заявку?">Отмена</button>
                }
                @if (terminal)
                {
                    <button type="button" class="btn btn-act btn-act-unavailable" disabled>Действия недоступны</button>
                }
                @if (Model.CanFileComplaint && !Model.ShowComplaintForm)
                {
                    <a class="btn btn-act btn-act-complaint" href="/requests/@item.Id?complaint=true">Жалоба</a>
                }
            </div>
        </form>

        @if (Model.CanReassign)
        {
            <form method="post" asp-page-handler="Reassign" asp-route-id="@item.Id" class="crown-entity-form mt-4">
                <input type="hidden" name="rowVersion" value="@item.RowVersion" />
                <h3 class="h6 text-uppercase text-muted mb-2">Перенаправить</h3>
                <div class="transport-form-grid">
                    <div class="mb-2">
                        <label class="form-label" for="reassign-executor">Новый исполнитель <span class="crown-req">*</span></label>
                        <select class="form-select" id="reassign-executor" name="executorUserId" required>
                            <option value="">— выберите —</option>
                            @foreach (var u in Model.Assignees)
                            {
                                var selected = Model.ReassignExecutorUserId == u.Id;
                                // Нельзя оставить текущего и нельзя назначить инициатора.
                                if (item.ExecutorUserId == u.Id || item.InitiatorUserId == u.Id)
                                {
                                    continue;
                                }
                                <option value="@u.Id" selected="@selected">@u.DisplayName (@u.UserName)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="reassign-comment">Комментарий <span class="crown-req">*</span></label>
                        <textarea class="form-control" id="reassign-comment" name="comment" rows="2" required
                                  placeholder="Причина перенаправления">@Model.ReassignCommentInput</textarea>
                    </div>
                </div>
                <button type="submit" class="btn btn-outline-primary btn-sm"
                        data-confirm="Перенаправить заявку? Бронь единицы будет снята, статус — «Подана».">
                    Перенаправить
                </button>
            </form>
        }
    </div>

    @if (item.HasComplaint)
    {
        <section class="crown-complaint-panel" aria-label="Жалоба">
            <p class="crown-complaint-meta">
                @(item.ComplaintByName ?? item.InitiatorName) оставил жалобу
                @(item.ComplaintAt is null ? "" : Time.Format(item.ComplaintAt))
            </p>
            <div class="crown-body">@item.ComplaintText</div>
        </section>
    }
    else if (Model.ShowComplaintForm && Model.CanFileComplaint)
    {
        <form method="post" asp-page-handler="Complaint" asp-route-id="@item.Id" class="crown-complaint-form">
            <textarea class="form-control" name="complaintText" rows="4"
                      placeholder="Здесь текст жалобы">@Model.ComplaintTextInput</textarea>
            <div class="crown-complaint-confirm">
                <p class="mb-2">
                    Внимание! Вы подаете жалобу на действия службы. Вы подтверждаете, что жалоба обоснована
                    и что Вы подробно описали суть жалобы.
                </p>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="complaintConfirmed" value="true" id="complaintConfirmed" />
                    <label class="form-check-label" for="complaintConfirmed">Я согласен</label>
                </div>
            </div>
            <button type="submit" class="btn btn-act btn-act-complaint">Подать жалобу</button>
            <a class="btn btn-secondary" href="/requests/@item.Id">Отмена</a>
        </form>
    }

    @* Блок вложений — как ServiceItems / AddServiceItem на карточке сделки. *@
    <section class="page-section">
        <h3 class="section-title">Вложения</h3>

        @if (item.Attachments.Count == 0)
        {
            <p class="text-muted">Файлов нет.</p>
        }
        else
        {
            <table class="table crown-table">
                <thead>
                <tr><th>Файл</th><th>Размер</th><th>Загружен</th></tr>
                </thead>
                <tbody>
                @foreach (var a in item.Attachments)
                {
                    <tr class="table-row-action"
                        data-href="/file-preview?requestId=@item.Id&amp;attachmentId=@a.Id&amp;back=@Uri.EscapeDataString($"/requests/{item.Id}")"
                        tabindex="0" role="link" aria-label="Вложение: @a.FileName">
                        <td>
                            <span class="doc-entry-link">@a.FileName</span>
                            <a class="ms-2 text-muted"
                               href="/requests/@item.Id?handler=Download&amp;attachmentId=@a.Id"
                               download title="Скачать">↓</a>
                        </td>
                        <td class="nowrap">@UiHelpers.FormatBytes(a.SizeBytes)</td>
                        <td class="nowrap">@Time.Format(a.UploadedAt)</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="page-section">
        <h3 class="section-title">Добавить вложение</h3>
        <form method="post" enctype="multipart/form-data"
              asp-page-handler="Upload" asp-route-id="@item.Id"
              class="form-panel crown-upload-form">
            <div class="mb-3">
                <label class="form-label" for="attachment-file">Файл</label>
                <input class="form-control" type="file" id="attachment-file" name="file" required />
            </div>
            <button type="submit" class="btn btn-success">Загрузить</button>
        </form>
    </section>
</div>
