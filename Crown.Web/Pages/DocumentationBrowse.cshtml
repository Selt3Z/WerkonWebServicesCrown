@page "/documentation/{libraryId:guid}"
@model DocumentationBrowseModel
@inject AppTime Time
@{
    ViewData["Title"] = "Документация";
    var b = Model.Browse;
    var isSearch = !string.IsNullOrWhiteSpace(b?.SearchQuery);
    var backHere = $"/documentation/{Model.LibraryId}"
        + (Model.FolderId is Guid f ? $"?folderId={f}" : "")
        + (!string.IsNullOrWhiteSpace(Model.Q)
            ? $"{(Model.FolderId is null ? "?" : "&")}q={Uri.EscapeDataString(Model.Q)}"
            : "");
    var resetHref = $"/documentation/{Model.LibraryId}"
        + (Model.FolderId is Guid rf ? $"?folderId={rf}" : "");
    var libName = b?.LibraryName ?? "Каталог";
    var inLibrarySubtree = b is not null && (b.FolderId is not null || isSearch);
}

<div class="crown-page-head">
    <h1 class="section-title">Документация</h1>
    <div class="d-flex gap-2 flex-wrap">
        @if (b?.CanViewTrash == true)
        {
            <a class="btn btn-outline-secondary" href="/documentation/@Model.LibraryId/trash">Корзина</a>
        }
        <a class="btn btn-outline-secondary" href="/documentation">К списку</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
@if (!string.IsNullOrEmpty(Model.Info))
{
    <div class="alert alert-success">@Model.Info</div>
}

@if (b is not null)
{
    <nav class="mb-3" aria-label="Путь">
        <a href="/documentation">Каталоги</a>
        <span class="text-muted"> / </span>
        @if (inLibrarySubtree)
        {
            <a href="/documentation/@b.LibraryId">@libName</a>
        }
        else
        {
            <span>@libName</span>
        }
        @if (b.FolderId is Guid && !isSearch)
        {
            <span class="text-muted"> / </span>
            @if (b.ParentFolderId is Guid parentId)
            {
                <a href="/documentation/@b.LibraryId?folderId=@parentId">↑ вверх</a>
                <span class="text-muted"> / </span>
            }
            <span>@(b.FolderName ?? "Папка")</span>
        }
        @if (isSearch)
        {
            <span class="text-muted"> / </span>
            <span>Поиск: «@b.SearchQuery»</span>
        }
    </nav>

    <form method="get" class="list-filters clients-filters mb-3">
        <input type="hidden" name="folderId" value="@Model.FolderId" />
        <div class="filter-field filter-field-inline filter-field-search">
            <label class="form-label" for="doc-q">Поиск</label>
            <input id="doc-q" class="form-control" type="search" name="q" value="@Model.Q"
                   placeholder="имя файла или папки…" />
        </div>
        <button type="submit" class="btn btn-primary">Найти</button>
        <a class="btn btn-secondary" href="@resetHref">Сбросить</a>
    </form>

    @if (b.CanWrite && !isSearch)
    {
        <div class="list-filters documentation-toolbar mb-3">
            <form method="post" asp-page-handler="CreateFolder" class="filter-field filter-field-inline">
                <input type="hidden" name="LibraryId" value="@Model.LibraryId" />
                <input type="hidden" name="FolderId" value="@Model.FolderId" />
                <label class="form-label" for="new-folder">Новая папка</label>
                <div class="d-flex gap-2 flex-nowrap align-items-center">
                    <input id="new-folder" class="form-control" name="NewFolderName" maxlength="200" required placeholder="Имя папки" />
                    <button type="submit" class="btn btn-success">Создать</button>
                </div>
            </form>
            <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" class="filter-field filter-field-inline">
                <input type="hidden" name="LibraryId" value="@Model.LibraryId" />
                <input type="hidden" name="FolderId" value="@Model.FolderId" />
                <label class="form-label" for="doc-file">Загрузить файл</label>
                <div class="d-flex gap-2 flex-nowrap align-items-center">
                    <input id="doc-file" class="form-control" type="file" name="UploadFile" required />
                    <button type="submit" class="btn btn-primary">Загрузить</button>
                </div>
            </form>
            @if (Model.IsAdmin)
            {
                <form method="post" asp-page-handler="SyncInbox" class="filter-field filter-field-inline">
                    <input type="hidden" name="LibraryId" value="@Model.LibraryId" />
                    <input type="hidden" name="FolderId" value="@Model.FolderId" />
                    <label class="form-label" for="sync-inbox-btn">С диска</label>
                    <div class="d-flex gap-2 flex-nowrap align-items-center">
                        <button id="sync-inbox-btn" type="submit" class="btn btn-outline-primary">
                            Импорт@(Model.Inbox is { PendingFileCount: > 0 } ? $" ({Model.Inbox.PendingFileCount})" : "")
                        </button>
                    </div>
                </form>
            }
        </div>
        @if (Model.IsAdmin && Model.Inbox is not null)
        {
            <p class="form-text mb-3">
                Большие файлы копируйте в папку на сервере:
                <code>@Model.Inbox.HostInboxPath</code>
                (до @(Model.Inbox.MaxInboxFileBytes / (1024 * 1024)) МБ; подхват ~5 мин или кнопка «Импорт»).
            </p>
        }
    }

    <div class="crown-table-wrap">
        <table class="table crown-table">
            <thead>
            <tr>
                <th>Имя</th>
                @if (isSearch)
                {
                    <th>Путь</th>
                }
                <th class="col-date">Размер</th>
                <th class="col-date">Дата</th>
                @if (b.CanWrite && !isSearch)
                {
                    <th class="col-actions">Действия</th>
                }
            </tr>
            </thead>
            <tbody>
            @{
                var colCount = 3 + (isSearch ? 1 : 0) + (b.CanWrite && !isSearch ? 1 : 0);
            }
            @if (b.Folders.Count == 0 && b.Files.Count == 0)
            {
                <tr class="crown-empty-row"><td colspan="@colCount" class="text-muted text-center">@(isSearch ? "Ничего не найдено." : "Пусто.")</td></tr>
            }
            @foreach (var folder in b.Folders)
            {
                <tr class="table-row-action" data-href="/documentation/@b.LibraryId?folderId=@folder.Id" tabindex="0" role="link"
                    aria-label="Папка: @folder.Name">
                    <td>
                        <span class="doc-entry-link">
                            <span class="doc-icon doc-icon-folder" aria-hidden="true"></span>
                            <span>@folder.Name</span>
                        </span>
                    </td>
                    @if (isSearch)
                    {
                        <td class="text-muted">@(folder.PathLabel ?? "Корень")</td>
                    }
                    <td class="col-date text-muted">—</td>
                    <td class="col-date">@Time.Format(folder.CreatedAt)</td>
                    @if (b.CanWrite && !isSearch)
                    {
                        <td class="col-actions doc-row-actions" onclick="event.stopPropagation()">
                            <div class="doc-row-actions-inner">
                                <form method="post" asp-page-handler="MoveFolder" class="documentation-move-form">
                                    <input type="hidden" name="LibraryId" value="@Model.LibraryId" />
                                    <input type="hidden" name="FolderId" value="@Model.FolderId" />
                                    <input type="hidden" name="targetFolderId" value="@folder.Id" />
                                    <label class="form-label" for="move-folder-@folder.Id">Переместить в</label>
                                    <select id="move-folder-@folder.Id" class="form-select" name="moveToParentId">
                                        <option value="">Корень каталога</option>
                                        @foreach (var dest in Model.MoveTargets.Where(x => x.Id != folder.Id))
                                        {
                                            <option value="@dest.Id">@(dest.PathLabel ?? dest.Name)</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">OK</button>
                                </form>
                                <form method="post" asp-page-handler="DeleteFolder" class="documentation-row-form">
                                    <input type="hidden" name="LibraryId" value="@Model.LibraryId" />
                                    <input type="hidden" name="FolderId" value="@Model.FolderId" />
                                    <input type="hidden" name="targetFolderId" value="@folder.Id" />
                                    <button type="submit" class="btn-icon-delete" title="Удалить"
                                            aria-label="Удалить папку @folder.Name"
                                            data-confirm="@(b.DeletesPermanently
                                                ? $"Удалить папку «{folder.Name}» безвозвратно со всем содержимым?"
                                                : $"Переместить папку «{folder.Name}» со всем содержимым в корзину?")">
                                        <svg class="btn-icon-delete-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    }
                </tr>
            }
            @foreach (var file in b.Files)
            {
                var previewHref = $"/documentation/preview?fileId={file.Id}&back={Uri.EscapeDataString(backHere)}";
                <tr class="table-row-action" data-href="@previewHref" tabindex="0" role="link"
                    aria-label="Файл: @file.FileName">
                    <td>
                        <span class="doc-entry-link">
                            <span class="doc-icon doc-icon-file" aria-hidden="true"></span>
                            <span>@file.FileName</span>
                        </span>
                        <a class="ms-2 text-muted"
                           href="/documentation/@b.LibraryId?handler=Download&amp;fileId=@file.Id"
                           download title="Скачать">↓</a>
                    </td>
                    @if (isSearch)
                    {
                        <td>
                            @if (file.FolderId is Guid fileFolderId)
                            {
                                <a class="text-muted" href="/documentation/@b.LibraryId?folderId=@fileFolderId">@(file.PathLabel ?? "Папка")</a>
                            }
                            else
                            {
                                <a class="text-muted" href="/documentation/@b.LibraryId">Корень</a>
                            }
                        </td>
                    }
                    <td class="col-date nowrap">@UiHelpers.FormatBytes(file.SizeBytes)</td>
                    <td class="col-date">@Time.Format(file.UploadedAt)</td>
                    @if (b.CanWrite && !isSearch)
                    {
                        <td class="col-actions doc-row-actions" onclick="event.stopPropagation()">
                            <div class="doc-row-actions-inner">
                                <form method="post" asp-page-handler="MoveFile" class="documentation-move-form">
                                    <input type="hidden" name="LibraryId" value="@Model.LibraryId" />
                                    <input type="hidden" name="FolderId" value="@Model.FolderId" />
                                    <input type="hidden" name="targetFileId" value="@file.Id" />
                                    <label class="form-label" for="move-file-@file.Id">Переместить в</label>
                                    <select id="move-file-@file.Id" class="form-select" name="moveToFolderId">
                                        <option value="">Корень каталога</option>
                                        @foreach (var dest in Model.MoveTargets)
                                        {
                                            <option value="@dest.Id">@(dest.PathLabel ?? dest.Name)</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">OK</button>
                                </form>
                                <form method="post" asp-page-handler="DeleteFile" class="documentation-row-form">
                                    <input type="hidden" name="LibraryId" value="@Model.LibraryId" />
                                    <input type="hidden" name="FolderId" value="@Model.FolderId" />
                                    <input type="hidden" name="targetFileId" value="@file.Id" />
                                    <button type="submit" class="btn-icon-delete" title="Удалить"
                                            aria-label="Удалить файл @file.FileName"
                                            data-confirm="@(b.DeletesPermanently
                                                ? $"Удалить файл «{file.FileName}» безвозвратно?"
                                                : $"Переместить файл «{file.FileName}» в корзину?")">
                                        <svg class="btn-icon-delete-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
