@page "/documentation/{ownerUserId:guid}"
@model DocumentationBrowseModel
@inject AppTime Time
@{
    ViewData["Title"] = "Документация";
    var b = Model.Browse;
    var isSearch = !string.IsNullOrWhiteSpace(b?.SearchQuery);
    var backHere = $"/documentation/{Model.OwnerUserId}"
        + (Model.FolderId is Guid f ? $"?folderId={f}" : "")
        + (!string.IsNullOrWhiteSpace(Model.Q)
            ? $"{(Model.FolderId is null ? "?" : "&")}q={Uri.EscapeDataString(Model.Q)}"
            : "");
    var resetHref = $"/documentation/{Model.OwnerUserId}"
        + (Model.FolderId is Guid rf ? $"?folderId={rf}" : "");
    var deptName = b?.OwnerDisplayName ?? "Подразделение";
    var inDeptSubtree = b is not null && (b.FolderId is not null || isSearch);
}

<div class="crown-page-head">
    <h1 class="section-title">Документация</h1>
    <div class="d-flex gap-2 flex-wrap">
        @if (b?.CanViewTrash == true)
        {
            <a class="btn btn-outline-secondary" href="/documentation/@Model.OwnerUserId/trash">Корзина</a>
        }
        <a class="btn btn-outline-secondary" href="/documentation">К списку</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (b is not null)
{
    <nav class="mb-3" aria-label="Путь">
        <a href="/documentation">Список подразделений</a>
        <span class="text-muted"> / </span>
        @if (inDeptSubtree)
        {
            <a href="/documentation/@b.OwnerUserId">@deptName</a>
        }
        else
        {
            <span>@deptName</span>
        }
        @if (b.FolderId is Guid && !isSearch)
        {
            <span class="text-muted"> / </span>
            @if (b.ParentFolderId is Guid parentId)
            {
                <a href="/documentation/@b.OwnerUserId?folderId=@parentId">↑ вверх</a>
                <span class="text-muted"> / </span>
            }
            <span>@(b.FolderName ?? "Папка")</span>
        }
        @if (isSearch)
        {
            <span class="text-muted"> / </span>
            <span>Поиск: «@b.SearchQuery»</span>
        }
    </nav>

    <form method="get" class="list-filters clients-filters mb-3">
        <input type="hidden" name="folderId" value="@Model.FolderId" />
        <div class="filter-field filter-field-inline filter-field-search">
            <label class="form-label" for="doc-q">Поиск</label>
            <input id="doc-q" class="form-control" type="search" name="q" value="@Model.Q"
                   placeholder="имя файла или папки…" />
        </div>
        <button type="submit" class="btn btn-primary">Найти</button>
        <a class="btn btn-secondary" href="@resetHref">Сбросить</a>
    </form>

    @if (b.CanWrite && !isSearch)
    {
        <div class="list-filters mb-3">
            <form method="post" asp-page-handler="CreateFolder" class="filter-field filter-field-inline">
                <input type="hidden" name="OwnerUserId" value="@Model.OwnerUserId" />
                <input type="hidden" name="FolderId" value="@Model.FolderId" />
                <label class="form-label" for="new-folder">Новая папка</label>
                <div class="d-flex gap-2 flex-wrap">
                    <input id="new-folder" class="form-control" name="NewFolderName" maxlength="200" required placeholder="Имя папки" />
                    <button type="submit" class="btn btn-success">Создать</button>
                </div>
            </form>
            <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" class="filter-field filter-field-inline">
                <input type="hidden" name="OwnerUserId" value="@Model.OwnerUserId" />
                <input type="hidden" name="FolderId" value="@Model.FolderId" />
                <label class="form-label" for="doc-file">Загрузить файл</label>
                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <input id="doc-file" class="form-control" type="file" name="UploadFile" required />
                    <button type="submit" class="btn btn-primary">Загрузить</button>
                </div>
            </form>
        </div>
    }

    <div class="crown-table-wrap">
        <table class="table crown-table">
            <thead>
            <tr>
                <th>Имя</th>
                @if (isSearch)
                {
                    <th>Путь</th>
                }
                <th class="col-date">Размер</th>
                <th class="col-date">Дата</th>
                @if (b.CanWrite && !isSearch)
                {
                    <th class="col-actions"></th>
                }
            </tr>
            </thead>
            <tbody>
            @{
                var colCount = 3 + (isSearch ? 1 : 0) + (b.CanWrite && !isSearch ? 1 : 0);
            }
            @if (b.Folders.Count == 0 && b.Files.Count == 0)
            {
                <tr class="crown-empty-row"><td colspan="@colCount" class="text-muted text-center">@(isSearch ? "Ничего не найдено." : "Пусто.")</td></tr>
            }
            @foreach (var folder in b.Folders)
            {
                <tr class="table-row-action" data-href="/documentation/@b.OwnerUserId?folderId=@folder.Id" tabindex="0" role="link"
                    aria-label="Папка: @folder.Name">
                    <td>
                        <span class="doc-entry-link">
                            <span class="doc-icon doc-icon-folder" aria-hidden="true"></span>
                            <span>@folder.Name</span>
                        </span>
                    </td>
                    @if (isSearch)
                    {
                        <td class="text-muted">@(folder.PathLabel ?? "Корень")</td>
                    }
                    <td class="col-date text-muted">—</td>
                    <td class="col-date">@Time.Format(folder.CreatedAt)</td>
                    @if (b.CanWrite && !isSearch)
                    {
                        <td class="col-actions table-row-actions">
                            <form method="post" asp-page-handler="DeleteFolder" class="d-inline">
                                <input type="hidden" name="OwnerUserId" value="@Model.OwnerUserId" />
                                <input type="hidden" name="FolderId" value="@Model.FolderId" />
                                <input type="hidden" name="targetFolderId" value="@folder.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        data-confirm="@(b.DeletesPermanently
                                            ? $"Удалить папку «{folder.Name}» безвозвратно со всем содержимым?"
                                            : $"Переместить папку «{folder.Name}» со всем содержимым в корзину?")">Удалить</button>
                            </form>
                        </td>
                    }
                </tr>
            }
            @foreach (var file in b.Files)
            {
                var previewHref = $"/documentation/preview?fileId={file.Id}&back={Uri.EscapeDataString(backHere)}";
                <tr class="table-row-action" data-href="@previewHref" tabindex="0" role="link"
                    aria-label="Файл: @file.FileName">
                    <td>
                        <span class="doc-entry-link">
                            <span class="doc-icon doc-icon-file" aria-hidden="true"></span>
                            <span>@file.FileName</span>
                        </span>
                        <a class="ms-2 text-muted"
                           href="/documentation/@b.OwnerUserId?handler=Download&amp;fileId=@file.Id"
                           download title="Скачать">↓</a>
                    </td>
                    @if (isSearch)
                    {
                        <td>
                            @if (file.FolderId is Guid fileFolderId)
                            {
                                <a class="text-muted" href="/documentation/@b.OwnerUserId?folderId=@fileFolderId">@(file.PathLabel ?? "Папка")</a>
                            }
                            else
                            {
                                <a class="text-muted" href="/documentation/@b.OwnerUserId">Корень</a>
                            }
                        </td>
                    }
                    <td class="col-date nowrap">@UiHelpers.FormatBytes(file.SizeBytes)</td>
                    <td class="col-date">@Time.Format(file.UploadedAt)</td>
                    @if (b.CanWrite && !isSearch)
                    {
                        <td class="col-actions table-row-actions">
                            <form method="post" asp-page-handler="DeleteFile" class="d-inline">
                                <input type="hidden" name="OwnerUserId" value="@Model.OwnerUserId" />
                                <input type="hidden" name="FolderId" value="@Model.FolderId" />
                                <input type="hidden" name="targetFileId" value="@file.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        data-confirm="@(b.DeletesPermanently
                                            ? $"Удалить файл «{file.FileName}» безвозвратно?"
                                            : $"Переместить файл «{file.FileName}» в корзину?")">Удалить</button>
                            </form>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
