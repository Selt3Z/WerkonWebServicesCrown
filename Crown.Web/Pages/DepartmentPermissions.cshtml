@page "/settings/department-permissions"
@model DepartmentPermissionsModel
@functions {
    private static string RoleBadgeClass(string? role) => role switch
    {
        AppRoles.Brigade => "bg-warning text-dark",
        AppRoles.Customer => "bg-info text-dark",
        _ => "bg-primary"
    };
}
@{
    ViewData["Title"] = "Права подразделений";
}

<div class="crown-page-head">
    <h1 class="section-title">Права подразделений, заказчиков и бригад</h1>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="text-muted mb-3 department-permissions-help">
    <p class="mb-2">Матрица прав учётных записей с ролями «Подразделение», «Бригада» и «Заказчик».</p>
    
    <ul class="mb-2 ps-3">
        <li><strong>Исполнитель</strong> — в списке исполнителей заявок.</li>
        <li><strong>Заявки на спецтехнику</strong> — может подавать заявки на спецтехнику.</li>
        <li><strong>Своё оборудование</strong> — CRUD своих единиц. Без галочки: можно запрашивать единицы и держать чужие на балансе.</li>
        <li><strong>Транспорт</strong> — просмотр страницы «Транспорт» и добавление стоянок/машин в справочник.</li>
        <li><strong>Спецтехника</strong> — просмотр страницы «Спецтехника».</li>
        <li><strong>Склад</strong> — просмотр страницы «Склад».</li>
        <li><strong>Сводка</strong> — просмотр страницы «Сводка».</li>
        <li><strong>Рейтинг бригад</strong> — только просмотр: раздел, рейтинг и таблицы остановок/проверок.</li>
        <li><strong>Оператор рейтинга</strong> — работа с разделом: добавление, правка и удаление остановок, проверок, пунктов акта и выполняемых работ.</li>
        <li><strong>Документация</strong> — общий доступ к разделу Документация (меню). Конкретные каталоги и запись — в «Доступ к документации».</li>

    </ul>
</div>

<div class="list-filters mb-3">
    <div class="filter-field filter-field-inline">
        <label class="form-label" for="perm-role-filter">Роль</label>
        <select class="form-select" id="perm-role-filter">
            <option value="">Все</option>
            @foreach (var role in AppRoles.Switchable)
            {
                <option value="@role">@AppRoles.Display(role)</option>
            }
        </select>
    </div>
</div>

<form method="post" class="department-permissions-form">
    <div class="crown-table-wrap department-permissions-wrap mb-3">
        <table class="table crown-table department-permissions-table" id="perm-matrix-table">
            <thead>
            <tr>
                <th>Пользователь</th>
                <th class="text-center" title="В списке исполнителей заявок">Исполн.</th>
                <th class="text-center" title="Может подавать заявки на спецтехнику">Заявки на СТ</th>
                <th class="text-center" title="CRUD единиц оборудования">Своё оборуд.</th>
                <th class="text-center" title="Просмотр Транспорта + добавление стоянок и машин">Трансп.</th>
                <th class="text-center" title="Просмотр страницы Спецтехника">СТ</th>
                <th class="text-center" title="Просмотр страницы Склад">Склад</th>
                <th class="text-center" title="Просмотр страницы Сводка">Сводка</th>
                <th class="text-center" title="Просмотр рейтинга бригад: рейтинг и таблицы остановок/проверок">РБ</th>
                <th class="text-center" title="Работа с рейтингом бригад: остановки, проверки, пункты акта, выполняемые работы">Оп. РБ</th>
                <th class="text-center" title="Общий доступ к Документации (меню); каталоги — в настройках ACL">Док.</th>
            </tr>
            </thead>
            <tbody>
            @for (var i = 0; i < Model.Users.Count; i++)
            {
                var u = Model.Users[i];
                var row = Model.Rows.ElementAtOrDefault(i) ?? new DepartmentPermissionsModel.DepartmentPermissionRowInput { UserId = u.UserId };
                <tr class="@(!u.IsActive ? "crown-row-archived" : null)" data-role="@u.Role">
                    <td title="@u.DisplayName">
                        @u.DisplayName
                        <span class="badge @RoleBadgeClass(u.Role) ms-1">@AppRoles.Display(u.Role)</span>
                        @if (!u.IsActive)
                        {
                            <span class="badge bg-secondary ms-1">выкл.</span>
                        }
                        @if (u.Role == AppRoles.Brigade
                            && (!string.IsNullOrWhiteSpace(u.BrigadeNumber) || !string.IsNullOrWhiteSpace(u.BrigadeWorkshop)))
                        {
                            <div class="text-muted small">
                                @if (!string.IsNullOrWhiteSpace(u.BrigadeNumber))
                                {
                                    <span>№ @u.BrigadeNumber</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(u.BrigadeWorkshop))
                                {
                                    <span>@(string.IsNullOrWhiteSpace(u.BrigadeNumber) ? null : " · ")цех @u.BrigadeWorkshop</span>
                                }
                            </div>
                        }
                        <input type="hidden" name="Rows[@i].UserId" value="@u.UserId" />
                    </td>
                    @* Без hidden false: в коллекции binder берёт первое значение и всегда пишет false. *@
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanBeExecutor" value="true" @(row.CanBeExecutor ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanCreateTransportRequests" value="true" @(row.CanCreateTransportRequests ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanManageEquipment" value="true" @(row.CanManageEquipment ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanViewTransport" value="true" @(row.CanViewTransport ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanViewSpecialVehicles" value="true" @(row.CanViewSpecialVehicles ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanViewWarehouse" value="true" @(row.CanViewWarehouse ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanViewSummary" value="true" @(row.CanViewSummary ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanViewBrigadeRating" value="true" @(row.CanViewBrigadeRating ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanOperateBrigadeRating" value="true" @(row.CanOperateBrigadeRating ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].DocumentationEnabled" value="true" @(row.DocumentationEnabled ? "checked" : null) />
                    </td>
                </tr>
            }
            @if (Model.Users.Count == 0)
            {
                <tr><td colspan="11" class="text-muted text-center">Нет пользователей с ролями «Подразделение», «Заказчик» или «Бригада».</td></tr>
            }
            </tbody>
        </table>
    </div>
    <button type="submit" class="btn btn-save">Сохранить</button>
</form>

@section Scripts {
<script>
(() => {
    const select = document.getElementById('perm-role-filter');
    const table = document.getElementById('perm-matrix-table');
    if (!select || !table) return;
    const rows = table.querySelectorAll('tbody tr[data-role]');
    const apply = () => {
        const role = select.value;
        rows.forEach(tr => {
            // Скрытые строки остаются в форме — Save не затирает чужие роли.
            tr.hidden = role !== '' && tr.getAttribute('data-role') !== role;
        });
    };
    select.addEventListener('change', apply);
    apply();
})();
</script>
}
