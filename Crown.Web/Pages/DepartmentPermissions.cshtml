@page "/settings/department-permissions"
@model DepartmentPermissionsModel
@{
    ViewData["Title"] = "Права подразделений";
}

<div class="crown-page-head">
    <h1 class="section-title">Права роли «Подразделение»</h1>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<p class="text-muted mb-3">
    Галочки только у учёток с ролью «Подразделение».
    Без «своего оборудования» можно запрашивать единицы и держать чужие на балансе.
    «Рейтинг бригад» — доступ к разделу и участие в рейтинге (это подразделение = бригада).
    «Оператор рейтинга» — может добавлять/править/удалять остановки.
    Без документации — раздел скрыт, чужие файлы всё ещё можно смотреть.
</p>

<form method="post" class="department-permissions-form">
    <div class="crown-table-wrap department-permissions-wrap mb-3">
        <table class="table crown-table department-permissions-table">
            <thead>
            <tr>
                <th>Подразделение</th>
                <th class="text-center" title="В списке исполнителей заявок">Исполнитель</th>
                <th class="text-center" title="Может подавать заявки RequestKind.SpecTech">Заявки на спецтехнику</th>
                <th class="text-center" title="CRUD единиц оборудования">Своё оборудование</th>
                <th class="text-center" title="Просмотр страницы Транспорт">Транспорт</th>
                <th class="text-center" title="Просмотр страницы Спецтехника">Спецтехника</th>
                <th class="text-center" title="Просмотр страницы Склад">Склад</th>
                <th class="text-center" title="Просмотр страницы Сводка">Сводка</th>
                <th class="text-center" title="Доступ к разделу + фигурант рейтинга (подразделение = бригада)">Рейтинг бригад</th>
                <th class="text-center" title="Добавление и правка остановок">Оператор рейтинга</th>
                <th class="text-center" title="Раздел документации + запись">Документация</th>
            </tr>
            </thead>
            <tbody>
            @for (var i = 0; i < Model.Users.Count; i++)
            {
                var u = Model.Users[i];
                var row = Model.Rows.ElementAtOrDefault(i) ?? new DepartmentPermissionsModel.DepartmentPermissionRowInput { UserId = u.UserId };
                <tr class="@(!u.IsActive ? "crown-row-archived" : null)">
                    <td title="@u.DisplayName">
                        @u.DisplayName
                        @if (!u.IsActive)
                        {
                            <span class="badge bg-secondary ms-1">выкл.</span>
                        }
                        <input type="hidden" name="Rows[@i].UserId" value="@u.UserId" />
                    </td>
                    @* Без hidden false: в коллекции binder берёт первое значение и всегда пишет false. *@
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanBeExecutor" value="true" @(row.CanBeExecutor ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanCreateTransportRequests" value="true" @(row.CanCreateTransportRequests ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanManageEquipment" value="true" @(row.CanManageEquipment ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanViewTransport" value="true" @(row.CanViewTransport ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanViewSpecialVehicles" value="true" @(row.CanViewSpecialVehicles ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanViewWarehouse" value="true" @(row.CanViewWarehouse ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanViewSummary" value="true" @(row.CanViewSummary ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanViewBrigadeRating" value="true" @(row.CanViewBrigadeRating ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].CanOperateBrigadeRating" value="true" @(row.CanOperateBrigadeRating ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input class="form-check-input" type="checkbox" name="Rows[@i].DocumentationEnabled" value="true" @(row.DocumentationEnabled ? "checked" : null) />
                    </td>
                </tr>
            }
            @if (Model.Users.Count == 0)
            {
                <tr><td colspan="11" class="text-muted text-center">Нет пользователей с ролью «Подразделение».</td></tr>
            }
            </tbody>
        </table>
    </div>
    <button type="submit" class="btn btn-save">Сохранить</button>
</form>
