@page "/documentation"
@model DocumentationModel
@inject AppTime Time
@{
    ViewData["Title"] = "Документация";
    var isSearch = Model.Search is not null;
}

<div class="crown-page-head">
    <h1 class="section-title">Документация</h1>
    @if (Model.IsAdmin)
    {
        <a class="btn btn-outline-secondary" href="/settings/documentation-access">Доступ к каталогам</a>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="get" class="list-filters clients-filters mb-3">
    <div class="filter-field filter-field-inline filter-field-search">
        <label class="form-label" for="doc-global-q">Поиск по всем каталогам</label>
        <input id="doc-global-q" class="form-control" type="search" name="q" value="@Model.Q"
               placeholder="имя файла или папки…" />
    </div>
    <button type="submit" class="btn btn-primary">Найти</button>
    @if (!string.IsNullOrWhiteSpace(Model.Q))
    {
        <a class="btn btn-secondary" href="/documentation">Сбросить</a>
    }
</form>

@if (Model.IsAdmin && !isSearch)
{
    <form method="post" asp-page-handler="CreateLibrary" class="list-filters mb-3">
        <div class="filter-field filter-field-inline">
            <label class="form-label" for="new-lib-name">Новый каталог</label>
            <input id="new-lib-name" class="form-control" name="NewLibraryName" required maxlength="200"
                   placeholder="Название" />
        </div>
        <div class="filter-field filter-field-inline">
            <label class="form-label" for="new-lib-inbox">Inbox key</label>
            <input id="new-lib-inbox" class="form-control" name="NewInboxFolderKey" maxlength="100"
                   placeholder="опционально" />
        </div>
        <button type="submit" class="btn btn-primary">Создать</button>
    </form>
}

@if (isSearch)
{
    <p class="text-muted mb-2">Поиск: «@Model.Search!.Query» · найдено @Model.Search.Hits.Count</p>
    <div class="crown-table-wrap">
        <table class="table crown-table">
            <thead>
            <tr>
                <th>Имя</th>
                <th>Каталог</th>
                <th>Путь</th>
                <th class="col-date">Размер</th>
                <th class="col-date">Дата</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Search.Hits.Count == 0)
            {
                <tr class="crown-empty-row"><td colspan="5" class="text-muted text-center">Ничего не найдено.</td></tr>
            }
            @foreach (var hit in Model.Search.Hits)
            {
                var href = hit.IsFolder
                    ? $"/documentation/{hit.LibraryId}?folderId={hit.Id}"
                    : $"/documentation/preview?fileId={hit.Id}&back={Uri.EscapeDataString("/documentation?q=" + Uri.EscapeDataString(Model.Q ?? ""))}";
                <tr class="table-row-action" data-href="@href" tabindex="0" role="link"
                    aria-label="@(hit.IsFolder ? "Папка" : "Файл"): @hit.Name">
                    <td>
                        <span class="doc-entry-link">
                            <span class="doc-icon @(hit.IsFolder ? "doc-icon-folder" : "doc-icon-file")" aria-hidden="true"></span>
                            <span>@hit.Name</span>
                        </span>
                        @if (!hit.IsFolder)
                        {
                            <a class="ms-2 text-muted"
                               href="/documentation/@hit.LibraryId?handler=Download&amp;fileId=@hit.Id"
                               download title="Скачать">↓</a>
                        }
                    </td>
                    <td>@hit.LibraryName</td>
                    <td class="text-muted">@(hit.PathLabel ?? "Корень")</td>
                    <td class="col-date nowrap">@(hit.IsFolder || hit.SizeBytes is null ? "—" : UiHelpers.FormatBytes(hit.SizeBytes.Value))</td>
                    <td class="col-date">@(hit.At is DateTimeOffset at ? Time.Format(at) : "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else if (Model.Libraries.Count == 0 && string.IsNullOrEmpty(Model.Error))
{
    <p class="text-muted">Нет доступных каталогов.</p>
}
else if (!isSearch)
{
    <div class="crown-table-wrap">
        <table class="table crown-table">
            <thead>
            <tr>
                <th>Каталог</th>
                <th class="num">Файлов</th>
                <th class="num">Объём</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Libraries)
            {
                <tr class="table-row-action" data-href="/documentation/@s.Id" tabindex="0" role="link"
                    aria-label="Документация: @s.Name">
                    <td>
                        <span class="doc-lib-name">
                            @if (s.CanWrite)
                            {
                                <span class="doc-lib-write-icon" title="Можно загружать и править" aria-label="Можно загружать и править">
                                    @* Открытый замок — право менять каталог, не «редактировать строку» *@
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                                        <path fill="currentColor" d="M11 1a2 2 0 0 0-2 2v4a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h5V3a3 3 0 0 1 6 0v4a.5.5 0 0 1-1 0V3a2 2 0 0 0-2-2zM3 8a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1H3z"/>
                                    </svg>
                                </span>
                            }
                            else
                            {
                                <span class="doc-lib-write-icon doc-lib-write-icon-spacer" aria-hidden="true"></span>
                            }
                            <span>@s.Name</span>
                        </span>
                    </td>
                    <td class="num">@s.FileCount</td>
                    <td class="num">@(s.FileCount == 0 ? "—" : UiHelpers.FormatBytes(s.TotalSizeBytes))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
