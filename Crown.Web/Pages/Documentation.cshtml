@page "/documentation"
@model DocumentationModel
@inject AppTime Time
@{
    ViewData["Title"] = "Документация";
    var isSearch = Model.Search is not null;
}

<div class="crown-page-head">
    <h1 class="section-title">Документация</h1>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="get" class="list-filters clients-filters mb-3">
    <div class="filter-field filter-field-inline filter-field-search">
        <label class="form-label" for="doc-global-q">Поиск по всем подразделениям</label>
        <input id="doc-global-q" class="form-control" type="search" name="q" value="@Model.Q"
               placeholder="имя файла или папки…" />
    </div>
    <button type="submit" class="btn btn-primary">Найти</button>
    @if (!string.IsNullOrWhiteSpace(Model.Q))
    {
        <a class="btn btn-secondary" href="/documentation">Сбросить</a>
    }
</form>

@if (isSearch)
{
    <p class="text-muted mb-2">Поиск: «@Model.Search!.Query» · найдено @Model.Search.Hits.Count</p>
    <div class="crown-table-wrap">
        <table class="table crown-table">
            <thead>
            <tr>
                <th>Имя</th>
                <th>Подразделение</th>
                <th>Путь</th>
                <th class="col-date">Размер</th>
                <th class="col-date">Дата</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Search.Hits.Count == 0)
            {
                <tr class="crown-empty-row"><td colspan="5" class="text-muted text-center">Ничего не найдено.</td></tr>
            }
            @foreach (var hit in Model.Search.Hits)
            {
                var href = hit.IsFolder
                    ? $"/documentation/{hit.OwnerUserId}?folderId={hit.Id}"
                    : $"/documentation/preview?fileId={hit.Id}&back={Uri.EscapeDataString("/documentation?q=" + Uri.EscapeDataString(Model.Q ?? ""))}";
                <tr class="table-row-action" data-href="@href" tabindex="0" role="link"
                    aria-label="@(hit.IsFolder ? "Папка" : "Файл"): @hit.Name">
                    <td>
                        <span class="doc-entry-link">
                            <span class="doc-icon @(hit.IsFolder ? "doc-icon-folder" : "doc-icon-file")" aria-hidden="true"></span>
                            <span>@hit.Name</span>
                        </span>
                        @if (!hit.IsFolder)
                        {
                            <a class="ms-2 text-muted"
                               href="/documentation/@hit.OwnerUserId?handler=Download&amp;fileId=@hit.Id"
                               download title="Скачать">↓</a>
                        }
                    </td>
                    <td>@hit.OwnerDisplayName</td>
                    <td class="text-muted">@(hit.PathLabel ?? "Корень")</td>
                    <td class="col-date nowrap">@(hit.IsFolder || hit.SizeBytes is null ? "—" : UiHelpers.FormatBytes(hit.SizeBytes.Value))</td>
                    <td class="col-date">@(hit.At is DateTimeOffset at ? Time.Format(at) : "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else if (Model.Sections.Count == 0 && string.IsNullOrEmpty(Model.Error))
{
    <p class="text-muted">Нет доступных подразделений в документации.</p>
}
else if (!isSearch)
{
    <div class="crown-table-wrap">
        <table class="table crown-table">
            <thead>
            <tr>
                <th>Подразделение</th>
                <th class="num">Файлов</th>
                <th class="num">Объём</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Sections)
            {
                <tr class="table-row-action" data-href="/documentation/@s.UserId" tabindex="0" role="link"
                    aria-label="Документация: @s.DisplayName">
                    <td>
                        @s.DisplayName
                        @if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == s.UserId.ToString())
                        {
                            <span class="badge text-bg-secondary ms-1">ваше</span>
                        }
                    </td>
                    <td class="num">@s.FileCount</td>
                    <td class="num">@(s.FileCount == 0 ? "—" : UiHelpers.FormatBytes(s.TotalSizeBytes))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
