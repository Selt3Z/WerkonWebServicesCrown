@page "/brigade-rating/act-items"
@model BrigadeRatingActItemsModel
@{
    ViewData["Title"] = "Пункты по акту предписания";
    var q = Model.Q;
}

<div class="crown-page-head">
    <h1 class="section-title">Пункты по акту предписания</h1>
    <div class="crown-page-head-actions">
        <a class="btn btn-outline-secondary" asp-page-handler="Export">Экспорт</a>
        <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="crown-op-form d-inline">
            <input type="file" id="act-import-file" name="ImportFile" class="d-none"
                   accept=".xlsx,.xls,.csv,.txt,.doc,.docx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/csv"
                   onchange="this.form.submit()" />
            <label for="act-import-file" class="btn btn-outline-primary mb-0" title="xlsx, xls, csv, txt, doc, docx">Импорт</label>
        </form>
        <a class="btn btn-outline-secondary" href="/brigade-rating">К рейтингу</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.CanClear)
{
    <form method="post" asp-page-handler="Clear" class="list-filters mb-3">
        <div class="filter-field filter-field-inline">
            <label class="form-label" for="act-clear-confirm">Подтверждение</label>
            <input id="act-clear-confirm" class="form-control" name="ClearConfirmation"
                   placeholder="Введите @BrigadeRatingActItemsModel.ClearConfirmationWord" autocomplete="off" required />
        </div>
        <div class="filter-field filter-field-inline">
            <label class="form-label" for="act-clear-password">Пароль админа</label>
            <input id="act-clear-password" class="form-control" type="password" name="ClearPassword"
                   autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn btn-outline-danger btn-sm"
                data-confirm="Удалить все пункты справочника безвозвратно? Связи в остановках/проверках обнулятся.">Очистить справочник</button>
    </form>
}

<form method="post" asp-page-handler="Add" class="list-filters mb-3">
    <input type="hidden" name="Q" value="@q" />
    <input type="hidden" name="p" value="@Model.PageIndex" />
    <div class="filter-field filter-field-inline filter-field-grow">
        <label class="form-label" for="new-act-text">Новый пункт</label>
        <input id="new-act-text" class="form-control" name="NewText" value="@Model.NewText" placeholder="Текст пункта по акту" required />
    </div>
    <button type="submit" class="btn btn-success">Добавить</button>
</form>

<form method="get" class="list-filters mb-3">
    <div class="filter-field filter-field-inline filter-field-grow catalog-list-filter">
        <label class="form-label" for="act-items-search">Поиск</label>
        <input id="act-items-search" class="form-control" type="search" name="q" value="@q" placeholder="Фильтр по тексту…" autocomplete="off" />
    </div>
    <button type="submit" class="btn btn-outline-secondary">Найти</button>
    @if (!string.IsNullOrWhiteSpace(q))
    {
        <a class="btn btn-outline-secondary" href="/brigade-rating/act-items">Сброс</a>
    }
</form>

<p class="text-muted small mb-2">Всего: @Model.Total · страница @Model.PageIndex / @Model.TotalPages</p>

<section class="entity-panel">
    @* Десктоп: таблица без «Статус». Мобилка: карточки — иначе Текст схлопывается. *@
    <div class="crown-table-wrap schedule-desktop-table">
        <table class="table crown-table act-items-table">
            <thead>
            <tr>
                <th style="width:3.5rem;">№</th>
                <th>Текст</th>
                <th style="width:14rem;"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="@(!item.IsActive ? "text-muted" : null)">
                    <td>@item.SortOrder</td>
                    <td>
                        <form method="post" asp-page-handler="Save" id="act-save-@item.Id" class="crown-op-form">
                            <input type="hidden" name="Q" value="@q" />
                            <input type="hidden" name="p" value="@Model.PageIndex" />
                            <input type="hidden" name="EditId" value="@item.Id" />
                            <input type="hidden" name="EditIsActive" value="@(item.IsActive ? "true" : "false")" />
                            <input class="form-control act-item-text" name="EditText" value="@item.Text" required />
                        </form>
                    </td>
                    <td class="text-end text-nowrap">
                        <button type="submit" form="act-save-@item.Id" class="btn btn-outline-secondary btn-sm">Сохранить</button>
                        <form method="post" asp-page-handler="Delete" class="crown-op-form d-inline">
                            <input type="hidden" name="Q" value="@q" />
                            <input type="hidden" name="p" value="@Model.PageIndex" />
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    data-confirm="Удалить пункт из справочника? В уже созданных остановках он станет «Вручную», текст и комментарий сохранятся.">
                                Удалить
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="3" class="text-muted text-center">@(string.IsNullOrWhiteSpace(q) ? "Пока пусто — добавьте типовые пункты сверху." : "Ничего не найдено.")</td></tr>
            }
            </tbody>
        </table>
    </div>

    <div class="schedule-mobile-cards act-items-mobile">
        @if (Model.Items.Count == 0)
        {
            <p class="text-muted text-center mb-0">@(string.IsNullOrWhiteSpace(q) ? "Пока пусто — добавьте типовые пункты сверху." : "Ничего не найдено.")</p>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <div class="schedule-card act-item-card @(!item.IsActive ? "text-muted" : null)">
                    <div class="schedule-card-header">
                        <span class="schedule-card-time">№ @item.SortOrder</span>
                    </div>
                    <form method="post" asp-page-handler="Save" id="act-save-m-@item.Id" class="crown-op-form act-item-card-form">
                        <input type="hidden" name="Q" value="@q" />
                        <input type="hidden" name="p" value="@Model.PageIndex" />
                        <input type="hidden" name="EditId" value="@item.Id" />
                        <input type="hidden" name="EditIsActive" value="@(item.IsActive ? "true" : "false")" />
                        <input class="form-control act-item-text" name="EditText" value="@item.Text" required />
                    </form>
                    <div class="act-item-card-actions">
                        <button type="submit" form="act-save-m-@item.Id" class="btn btn-outline-secondary btn-sm">Сохранить</button>
                        <form method="post" asp-page-handler="Delete" class="crown-op-form">
                            <input type="hidden" name="Q" value="@q" />
                            <input type="hidden" name="p" value="@Model.PageIndex" />
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    data-confirm="Удалить пункт из справочника? В уже созданных остановках он станет «Вручную», текст и комментарий сохранятся.">
                                Удалить
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</section>

@if (Model.TotalPages > 1)
{
    <nav class="list-filters mt-3" aria-label="Страницы">
        @if (Model.PageIndex > 1)
        {
            <a class="btn btn-outline-secondary btn-sm" href="?q=@Uri.EscapeDataString(q ?? "")&p=@(Model.PageIndex - 1)">← Назад</a>
        }
        @if (Model.PageIndex < Model.TotalPages)
        {
            <a class="btn btn-outline-secondary btn-sm" href="?q=@Uri.EscapeDataString(q ?? "")&p=@(Model.PageIndex + 1)">Вперёд →</a>
        }
    </nav>
}

@section Scripts {
<script>
(() => {
    const form = document.querySelector('form.list-filters[method="get"]');
    const input = document.getElementById('act-items-search');
    if (!form || !input) return;
    let t = 0;
    input.addEventListener('input', () => {
        clearTimeout(t);
        t = setTimeout(() => form.requestSubmit(), 350);
    });
})();
</script>
}
