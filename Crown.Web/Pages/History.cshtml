@page "/history"
@model HistoryModel
@{
    ViewData["Title"] = "Журнал";
}

<h1 class="section-title">Журнал</h1>

<form method="get" class="list-filters clients-filters mb-3">
    <div class="filter-field filter-field-inline">
        <label class="form-label" for="hist-user">Пользователь</label>
        <select id="hist-user" class="form-select" name="userId">
            <option value="">Все</option>
            @foreach (var u in Model.Users)
            {
                <option value="@u.UserId" selected="@(u.UserId == Model.UserId)">@u.DisplayName</option>
            }
        </select>
    </div>
    <div class="filter-field filter-field-inline">
        <label class="form-label" for="hist-entity">Тип</label>
        <input id="hist-entity" class="form-control" name="entityType" value="@Model.EntityType" placeholder="Тип записи" />
    </div>
    <div class="filter-field filter-field-inline">
        <label class="form-label" for="hist-from">С</label>
        <input id="hist-from" class="form-control" type="date" name="from" value="@Model.From" />
    </div>
    <div class="filter-field filter-field-inline">
        <label class="form-label" for="hist-to">По</label>
        <input id="hist-to" class="form-control" type="date" name="to" value="@Model.To" />
    </div>
</form>

<div class="action-bar mb-3">
    <button class="btn btn-primary" type="submit" form="" id="btn-hist-filters">Найти</button>
    <a class="btn btn-secondary" href="/history">Сбросить</a>
</div>
<script>
document.getElementById('btn-hist-filters')?.addEventListener('click', (e) => {
  e.preventDefault();
  document.querySelector('form.list-filters')?.requestSubmit();
});
</script>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="crown-table-wrap">
    <table class="table crown-table">
        <thead>
        <tr>
            <th>Время</th>
            <th>Пользователь</th>
            <th>Действие</th>
            <th>Тип</th>
            <th>Описание</th>
        </tr>
        </thead>
        <tbody data-infinite-scroll
               data-more-url="@UiHelpers.BuildUrl("/history", ("handler", "More"), ("userId", Model.UserId?.ToString()), ("entityType", Model.EntityType), ("from", Model.From), ("to", Model.To))"
               data-skip="@Model.Items.Count"
               data-has-more="@(Model.HasMore ? "true" : "false")">
        @if (Model.Items.Count == 0 && string.IsNullOrEmpty(Model.Error))
        {
            <tr class="crown-empty-row"><td colspan="5" class="text-muted text-center">Записей нет.</td></tr>
        }
        else
        {
            <partial name="_HistoryRows" model="Model.Items" />
        }
        </tbody>
    </table>
</div>
<div class="infinite-scroll-sentinel" hidden></div>
