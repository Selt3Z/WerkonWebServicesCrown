@page "/history"
@model HistoryModel
@inject AppTime Time
@{
    ViewData["Title"] = "Журнал";
}

<h1 class="section-title">Журнал</h1>

<form method="get" class="crown-filters">
    <select class="form-select" name="userId">
        <option value="">Все пользователи</option>
        @foreach (var u in Model.Users)
        {
            <option value="@u.UserId" selected="@(u.UserId == Model.UserId)">@u.DisplayName</option>
        }
    </select>
    <input class="form-control" name="entityType" value="@Model.EntityType" placeholder="Тип записи" />
    <input class="form-control" type="date" name="from" value="@Model.From" title="С даты" />
    <input class="form-control" type="date" name="to" value="@Model.To" title="По дату" />
    <button class="btn btn-primary" type="submit">Применить</button>
    <a class="btn btn-outline-secondary" href="/history">Сбросить</a>
</form>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="crown-table-wrap">
    <table class="table crown-table">
        <thead>
        <tr>
            <th>Время</th>
            <th>Пользователь</th>
            <th>Действие</th>
            <th>Тип</th>
            <th>Описание</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var a in Model.Items)
        {
            <tr>
                <td class="nowrap">@Time.FormatUtc(a.OccurredAtUtc)</td>
                <td>@a.UserDisplayName</td>
                <td>@a.Action</td>
                <td>@a.EntityType</td>
                <td>@a.Summary</td>
            </tr>
        }
        @if (Model.Items.Count == 0 && string.IsNullOrEmpty(Model.Error))
        {
            <tr><td colspan="5" class="text-muted text-center">Записей нет.</td></tr>
        }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="@(new PagerModel(Model.P, Model.HasMore, Model.PageUrl))" />
