@page "/catalog-parts/edit/{id:guid?}"
@model CatalogPartSaveModel
@{
    ViewData["Title"] = Model.IsEdit ? "Редактирование услуги" : "Новая услуга";
    var backHref = Model.IsStaff && (Model.Input.OwnerUserId ?? Model.OwnerUserId) is Guid oid
        ? $"/catalog-parts?ownerUserId={oid}"
        : "/catalog-parts";
}

<h1 class="section-title">@(Model.IsEdit ? "Редактирование услуги" : "Новая услуга")</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (!(Model.IsStaff && Model.Id is null && Model.OwnerUserId is null && string.IsNullOrEmpty(Model.Input.Name)))
{
    <form method="post" class="crown-form form-panel">
        @if (Model.IsStaff)
        {
            <input type="hidden" asp-for="OwnerUserId" />
            <input type="hidden" asp-for="Input.OwnerUserId" />
            <div class="mb-3">
                <label class="form-label">Подразделение (инициатор)</label>
                <input class="form-control form-control-locked" readonly tabindex="-1"
                       value="@(Model.Owners.FirstOrDefault(x => x.Id == (Model.Input.OwnerUserId ?? Model.OwnerUserId))?.DisplayName
                               ?? (Model.Input.OwnerUserId ?? Model.OwnerUserId)?.ToString()
                               ?? "—")" />
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Инициатор</label>
                <input class="form-control form-control-locked" readonly tabindex="-1"
                       value="@(User.FindFirst(CrownAuthHandler.DisplayNameClaim)?.Value
                               ?? User.Identity?.Name
                               ?? "—")" />
            </div>
        }

        <div class="mb-3">
            <label class="form-label" asp-for="Input.Name">Название <span class="crown-req">*</span></label>
            <input class="form-control" asp-for="Input.Name" required />
        </div>

        <div class="crown-form-grid">
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Code">Код</label>
                <input class="form-control" asp-for="Input.Code" />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Category">Категория</label>
                <input class="form-control" asp-for="Input.Category" list="cat-categories" />
                <datalist id="cat-categories">
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c"></option>
                    }
                </datalist>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.DefaultUnit">Ед. изм.</label>
                <select class="form-select" asp-for="Input.DefaultUnit">
                    @foreach (var u in MeasurementUnitOptions.All)
                    {
                        <option value="@u">@u</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.SlaHours">SLA, часов</label>
                <input class="form-control" type="number" min="1" asp-for="Input.SlaHours" placeholder="необяз." />
                <div class="form-text">Если задано — при выборе из каталога подставит срок заявки.</div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Input.Description">Описание</label>
            <textarea class="form-control" asp-for="Input.Description" rows="4"></textarea>
        </div>

        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" asp-for="Input.IsActive" />
            <label class="form-check-label" asp-for="Input.IsActive">Активна</label>
        </div>

        <div class="crown-form-actions">
            <button type="submit" class="btn btn-save btn-lg">СОХРАНИТЬ</button>
            <a class="btn btn-outline-secondary btn-lg" href="@backHref">Отмена</a>
        </div>
    </form>
}
else
{
    <a class="btn btn-outline-secondary" href="/catalog-parts">К списку</a>
}
