@model List<EquipmentAsset>
@foreach (var p in Model)
{
    var status = p.Availability switch
    {
        EquipmentAvailability.Reserved => "Бронь",
        _ => "Свободно"
    };
    <tr class="table-row-action @(p.IsArchived ? "crown-row-archived" : null)"
        data-href="/equipment/@p.Id"
        tabindex="0" role="link"
        aria-label="Оборудование: @p.Name">
        <td class="col-inv">@p.InventoryNumber</td>
        <td class="col-name" title="@p.Name">@p.Name</td>
        <td class="col-owner" title="@(p.OwnerLabel ?? "")">@(string.IsNullOrWhiteSpace(p.OwnerLabel) ? "—" : p.OwnerLabel)</td>
        <td class="col-loc" title="@(p.CurrentLocationLabel ?? "")">@(string.IsNullOrWhiteSpace(p.CurrentLocationLabel) ? "—" : p.CurrentLocationLabel)</td>
        <td class="col-status" title="@(p.ReservedByRequestId is long rid ? $"Забронировано (№{rid})" : status)">@status</td>
        <td class="col-pad" aria-hidden="true"></td>
    </tr>
}
