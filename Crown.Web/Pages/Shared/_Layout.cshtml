@{
    var path = Context.Request.Path.Value ?? "/";
    var isAdmin = User.IsInRole(AppRoles.Administrator);
    var isStaff = isAdmin || User.IsInRole(AppRoles.Dispatcher);
    var displayName = User.FindFirst(CrownAuthHandler.DisplayNameClaim)?.Value ?? string.Empty;
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var theme = Context.Request.Cookies[Crown.Web.Pages.SettingsModel.ThemeCookieName];
    if (string.IsNullOrWhiteSpace(theme))
    {
        theme = "light";
    }

    string Active(string prefix) =>
        path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;

    // «Заявки» активны на списке и карточке, но не на форме подачи.
    var requestsActive = path == "/"
        || (path.StartsWith("/requests", StringComparison.OrdinalIgnoreCase)
            && !path.StartsWith("/requests/new", StringComparison.OrdinalIgnoreCase))
        ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="ru" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] is string t ? t + " — Crown" : "Crown")</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/crown.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <input type="checkbox" id="nav-menu-toggle" class="navbar-toggler-state" tabindex="-1" aria-hidden="true" />
    <label for="nav-menu-toggle" class="nav-backdrop" aria-hidden="true"></label>

    <aside class="app-sidebar nav-sidebar">
        <div class="nav-brand">
            <a class="nav-brand-link" href="/" title="WWS Crown">
                <img class="nav-brand-logo" src="/brand-logo"
                     alt="WWS Crown"
                     onerror="this.onerror=null;this.src='@Url.Content("~/images/fulllogo.png")';" />
            </a>
        </div>

        <div class="nav-scrollable">
            <nav class="nav-section">
                @if (!isAdmin)
                {
                    <div class="nav-item">
                        <a class="nav-link @Active("/today")" href="/today">
                            <span class="bi bi-calendar3-nav-menu nav-menu-icon" aria-hidden="true"></span>
                            <span class="nav-menu-text">Сегодня</span>
                        </a>
                    </div>
                }
                <div class="nav-item">
                    <a class="nav-link @requestsActive" href="/">
                        <span class="bi bi-clipboard-check-nav-menu nav-menu-icon" aria-hidden="true"></span>
                        <span class="nav-menu-text">Заявки</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a class="nav-link @Active("/requests/new")" href="/requests/new">
                        <span class="bi bi-clipboard-plus-nav-menu nav-menu-icon" aria-hidden="true"></span>
                        <span class="nav-menu-text">Добавить заявку</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a class="nav-link @Active("/transport")" href="/transport">
                        <span class="bi bi-car-side-nav-menu nav-menu-icon" aria-hidden="true"></span>
                        <span class="nav-menu-text">Транспорт</span>
                    </a>
                </div>
                @if (isStaff)
                {
                    <div class="nav-item">
                        <a class="nav-link @Active("/warehouse")" href="/warehouse">
                            <span class="bi bi-box-seam-nav-menu nav-menu-icon" aria-hidden="true"></span>
                            <span class="nav-menu-text">Склад</span>
                        </a>
                    </div>
                }
                <div class="nav-item">
                    <a class="nav-link @Active("/catalog-parts")" href="/catalog-parts">
                        <span class="bi bi-journal-text-nav-menu nav-menu-icon" aria-hidden="true"></span>
                        <span class="nav-menu-text">Каталог</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a class="nav-link @Active("/summary")" href="/summary">
                        <span class="bi bi-bar-chart-nav-menu nav-menu-icon" aria-hidden="true"></span>
                        <span class="nav-menu-text">Сводка</span>
                    </a>
                </div>
            </nav>
        </div>

        @if (isStaff)
        {
            <div class="nav-bottom">
                <div class="nav-section-divider" aria-hidden="true"></div>
                <nav class="nav-section nav-section-admin">
                    <div class="nav-item">
                        <a class="nav-link @Active("/history")" href="/history">
                            <span class="bi bi-book-nav-menu nav-menu-icon" aria-hidden="true"></span>
                            <span class="nav-menu-text">Журнал</span>
                        </a>
                    </div>
                    @if (isAdmin)
                    {
                        <div class="nav-item">
                            <a class="nav-link @Active("/users")" href="/users">
                                <span class="bi bi-users-nav-menu nav-menu-icon" aria-hidden="true"></span>
                                <span class="nav-menu-text">Пользователи</span>
                            </a>
                        </div>
                        <div class="nav-item">
                            <a class="nav-link @Active("/settings")" href="/settings">
                                <span class="bi bi-gear-nav-menu nav-menu-icon" aria-hidden="true"></span>
                                <span class="nav-menu-text">Настройки</span>
                            </a>
                        </div>
                        <div class="nav-item">
                            <a class="nav-link @Active("/system")" href="/system">
                                <span class="bi bi-heart-pulse-nav-menu nav-menu-icon" aria-hidden="true"></span>
                                <span class="nav-menu-text">Состояние системы</span>
                            </a>
                        </div>
                    }
                </nav>
            </div>
        }

        <div class="nav-footer">
            @{
                var fullVer = System.Reflection.CustomAttributeExtensions.GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(
                    typeof(Program).Assembly)?.InformationalVersion ?? "1.0";
                var verParts = fullVer.Split('.', StringSplitOptions.RemoveEmptyEntries);
                var shortVer = verParts.Length >= 2 ? $"{verParts[0]}.{verParts[1]}" : fullVer;
            }
            <div class="nav-version">Crown v@(shortVer) · WWS</div>
        </div>
    </aside>

    <div class="app-frame">
        <header class="app-titlebar">
            <div class="app-titlebar-leading">
                <span class="app-titlebar-glyph" aria-hidden="true"></span>
                <span class="app-titlebar-caption">Crown</span>
            </div>

            <div class="app-user-tray">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="app-user-name"><span class="app-user-name-text">@displayName</span></span>
                    <span class="app-user-role">@AppRoles.Display(role)</span>
                    <div class="app-user-actions">
                        <form method="post" asp-page="/Logout" class="d-inline">
                            <button type="submit" class="btn-logout" title="Выйти" aria-label="Выйти">
                                <svg class="btn-logout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 17l5-5-5-5M21 12H9" />
                                </svg>
                            </button>
                        </form>
                        <label for="nav-menu-toggle" class="navbar-toggler-btn" title="Меню" aria-label="Меню"></label>
                    </div>
                }
                else
                {
                    <a class="app-user-role" href="/login">Войти</a>
                    <div class="app-user-actions">
                        <label for="nav-menu-toggle" class="navbar-toggler-btn" title="Меню" aria-label="Меню"></label>
                    </div>
                }
            </div>
        </header>

        <main class="app-workspace">
            <div class="app-workspace-well">
                <article class="page-content">
                    @if (TempData["Ok"] is string ok)
                    {
                        <div class="alert alert-success">@ok</div>
                    }
                    @if (TempData["Warn"] is string warn)
                    {
                        <div class="alert alert-warning">@warn</div>
                    }
                    @RenderBody()
                </article>
            </div>
        </main>
    </div>
</div>
<script src="~/js/crown.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
