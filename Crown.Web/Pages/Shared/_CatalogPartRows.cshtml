@model List<CatalogPart>
@foreach (var p in Model)
{
    <tr class="table-row-action @(p.IsActive ? null : "crown-row-archived")"
        data-href="/catalog-parts/edit/@p.Id"
        tabindex="0"
        role="link"
        aria-label="Услуга: @p.Name">
        <td class="nowrap">@(p.Code ?? "—")</td>
        <td>@p.Name</td>
        <td>@(p.Category ?? "—")</td>
        <td>@p.DefaultUnit</td>
        <td class="nowrap">@(p.SlaHours?.ToString() ?? "—")</td>
        <td>@(p.IsActive ? "Активна" : "Неактивна")</td>
    </tr>
}
