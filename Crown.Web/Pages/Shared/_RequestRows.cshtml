@model List<ServiceRequestListItem>
@inject AppTime Time
@foreach (var r in Model)
{
    <tr class="table-row-action @(r.IsUrgent ? "request-row-urgent" : null) @(r.IsArchived ? "crown-row-archived" : null)"
        data-href="/requests/@r.Id" tabindex="0" role="link" aria-label="Заявка № @r.Id">
        <td class="col-num">
            <span class="crown-id-cell">
                <span class="crown-warn-slot" aria-hidden="@(r.HasComplaint ? "false" : "true")">
                    @if (r.HasComplaint)
                    {
                        <span class="crown-warn-badge" title="По заявке подана жалоба" aria-label="Жалоба">!</span>
                    }
                </span>
                <span class="crown-id">@r.Id</span>
            </span>
        </td>
        <td class="crown-status-cell col-status">
            @{
                var statusTitleParts = new List<string>();
                if (r.Kind != ServiceRequestKind.Other) statusTitleParts.Add(r.KindLabel);
                if (r.IsUrgent) statusTitleParts.Add("срочная");
                var statusTitle = statusTitleParts.Count > 0 ? string.Join(" · ", statusTitleParts) : null;
            }
            <span class="crown-status-pill @UiHelpers.StatusClass(r.Status)" title="@statusTitle">@r.StatusLabel</span>
        </td>
        <td class="col-op">
            <span class="visit-payment-dot @(r.Acknowledged ? "visit-payment-dot-paid" : "visit-payment-dot-unpaid")"
                  title="@Time.AckTitle(r.Acknowledged, r.AcknowledgedAt)"
                  aria-label="@Time.AckTitle(r.Acknowledged, r.AcknowledgedAt)"></span>
        </td>
        <td class="col-init">@r.InitiatorName</td>
        <td class="col-date">@Time.Format(r.SubmittedAt)</td>
        <td class="col-date">@Time.Format(r.ReactionAt)</td>
        <td class="col-date">
            @if (r.CompletedAt is not null)
            {
                @Time.Format(r.CompletedAt)
            }
            else
            {
                <span class="text-muted" title="Срок исполнения">до @Time.Format(r.DueAt)</span>
            }
        </td>
        <td class="col-dept">@r.ExecutorName</td>
        <td class="col-phone">@UiHelpers.FormatPhone(r.Phone)</td>
        <td class="col-body">
            @if (r.Kind != ServiceRequestKind.Other)
            {
                <span class="text-muted">[@r.KindLabel] </span>
            }
            @r.BodyPreview
        </td>
    </tr>
}
